---
// 바닥글: 위쪽 메뉴와 같은 파란 간판 띠로 페이지를 닫습니다.
import Logo from '~/components/Logo.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import { langFromPath, localize } from '~/i18n';

interface Link {
  text?: string;
  href?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  footNote?: string;
  tagline?: string;
  owner?: string;
}

const { links = [], footNote = '', tagline = '', owner = '' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const home = localize(lang, '/');
---

<footer class="on-sign relative not-prose">
  <div class="rail-strip" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-flex min-h-11 items-center" href={home} translate="no">
          <Logo lang={lang} />
        </a>
        <p class="mt-3 max-w-xs text-white/85">{tagline}</p>
        <SocialShare class="mt-5 block" onSign />
      </div>
      {
        links.map(({ title, links }, index) => (
          <div class:list={['col-span-12 sm:col-span-4', index === 0 ? 'lg:col-span-2' : 'lg:col-span-3']}>
            <p class="mb-2 font-bold text-white">{title}</p>
            <ul class="text-[0.95rem]">
              {links.map(({ text, href }) => (
                <li>
                  {href ? (
                    <a
                      class="inline-block py-2 text-white/85 underline-offset-4 hover:text-white hover:underline"
                      href={href}
                    >
                      {text}
                    </a>
                  ) : (
                    <span class="block py-2 text-white/85">{text}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div
      class="mt-10 flex flex-col gap-1 border-t border-white/25 pt-6 text-sm text-white/75 sm:flex-row sm:justify-between"
    >
      <span>{owner}</span>
      <span>{footNote}</span>
    </div>
  </div>
</footer>
