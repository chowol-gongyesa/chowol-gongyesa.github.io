---
// 바닥글: 원목 띠 아래 밤 작업장 쪽빛 바탕, 메뉴·연락처·찾아오는 길, 맨 아래에 테두리만 남긴 커다란 상호.
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import { SHOP } from '~/data/shop';
import { langFromPath, localize, useT } from '~/i18n';

interface Link {
  text?: string;
  href?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  footNote?: string;
  tagline?: string;
  owner?: string;
}

const { links = [], footNote = '', tagline = '', owner = '' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const home = localize(lang, '/');
---

<footer class="sec-night relative overflow-hidden not-prose">
  <div class="rail-strip" aria-hidden="true"></div>
  <div class="relative z-[2] mx-auto max-w-7xl px-5 pt-16 pb-8 lg:px-8">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-flex min-h-11 items-center" href={home} translate="no">
          <Logo lang={lang} />
        </a>
        <p class="mt-4 max-w-xs text-paper/80">{tagline}</p>
        <SocialShare class="mt-6 block" onSign />
      </div>
      {
        links.map(({ title, links }, index) => (
          <div class:list={['col-span-12 sm:col-span-4', index === 0 ? 'lg:col-span-2' : 'lg:col-span-3']}>
            <p class="mb-3 font-bold text-wood">{title}</p>
            <ul class="text-[0.97rem]">
              {links.map(({ text, href }) => (
                <li>
                  {href ? (
                    <a class="inline-block py-1.5 text-paper/80 underline-offset-4 hover:text-white hover:underline" href={href}>
                      {text}
                    </a>
                  ) : (
                    <span class="block py-1.5 text-paper/80">{text}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-wood/20 pt-6 text-sm text-paper/65 sm:flex-row sm:items-center sm:justify-between">
      <span>{owner}</span>
      <span>{footNote}</span>
      <a href="#main" class="inline-flex min-h-11 items-center gap-1.5 text-paper/80 hover:text-white">
        <Icon name="tabler:arrow-up" class="h-4 w-4" aria-hidden="true" />{t.footer.top}
      </a>
    </div>
  </div>
  <p class="footer-word relative z-[1] -mb-[0.12em] text-center" aria-hidden="true">{SHOP.name}</p>
</footer>
