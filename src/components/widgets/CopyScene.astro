---
// 스크롤 장면: 화면이 멈춘 채로 스크롤하면, 맨 앞의 견본(주홍 테두리) 하나와 같은 모양이 하나씩 불을 켜며 늘어나고
// 숫자가 올라감. 왼쪽의 순서 1·2·3도 차례로 켜짐 = '견본 하나로, 몇 개든 똑같이'.
// 움직임 줄이기 설정이면 멈춤 없이 다 켜진 모습만 보여 줍니다.
import { verticalPath } from '~/utils/baluster';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useT(lang).copyScene;
const TOTAL = 100;
const path = verticalPath();
---

<section class="copy-scene sec-night" data-copy-scene aria-labelledby="copy-title">
  <div class="copy-sticky grain">
    <div class="relative z-[2] mx-auto grid w-full max-w-7xl gap-8 px-5 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:items-center md:gap-14 lg:px-8">
      <div>
        <h2 id="copy-title" class="display text-[clamp(2rem,4.6vw,3.6rem)] text-paper">{c.title}</h2>
        <p class="mt-4 hidden text-paper/75 sm:block">{c.lead}</p>
        <ol class="mt-6 space-y-3 md:mt-10 md:space-y-4">
          {
            c.steps.map((step, i) => (
              <li class="copy-step flex items-center gap-4 text-paper" data-step={i}>
                <span class="copy-step-num shrink-0">{i + 1}</span>
                <span class="text-[1.02rem] md:text-[1.12rem]">{step}</span>
              </li>
            ))
          }
        </ol>
        <p class="mt-6 flex items-baseline gap-3 md:mt-10" aria-hidden="true">
          <span class="copy-count text-[clamp(3.2rem,8vw,6rem)] text-wood" data-count>1</span>
          <span class="text-paper/80">{c.unit ? `${c.unit} ` : ''}{c.countLabel}</span>
        </p>
      </div>

      <div class="copy-grid" aria-hidden="true">
        <svg width="0" height="0" class="absolute">
          <defs>
            <linearGradient id="cs-wood" x1="0" x2="1">
              <stop offset="0" stop-color="#8f6a40"></stop>
              <stop offset="0.4" stop-color="#f3e3c3"></stop>
              <stop offset="1" stop-color="#7d5a35"></stop>
            </linearGradient>
            <symbol id="cs-b" viewBox="0 0 36 300"><path d={path} fill="url(#cs-wood)"></path></symbol>
          </defs>
        </svg>
        {
          Array.from({ length: TOTAL }, (_, i) => (
            <span class:list={[{ on: i === 0, 'is-sample': i === 0 }]}>
              <svg viewBox="0 0 36 300" preserveAspectRatio="none">
                <use href="#cs-b" />
              </svg>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .copy-grid .is-sample svg {
    filter: drop-shadow(0 0 6px rgb(196 67 47 / 0.9));
  }
  .copy-grid .is-sample {
    outline: 1px solid rgb(196 67 47 / 0.9);
    outline-offset: 2px;
  }
  @media (width < 48rem) {
    .copy-grid {
      --copy-h: 2.1rem;
      gap: 0.35rem 0.25rem;
    }
    .copy-grid span:nth-child(n + 82) {
      display: none;
    }
  }
</style>

<script>
  const setup = () => {
    const scene = document.querySelector<HTMLElement>('[data-copy-scene]');
    if (!scene || scene.dataset.ready) return;
    scene.dataset.ready = '1';
    const pieces = [...scene.querySelectorAll<HTMLElement>('.copy-grid > span')];
    const steps = [...scene.querySelectorAll<HTMLElement>('[data-step]')];
    const count = scene.querySelector<HTMLElement>('[data-count]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const visible = () => pieces.filter((p) => p.offsetParent !== null);
    if (reduce) {
      pieces.forEach((p) => p.classList.add('on'));
      steps.forEach((s) => s.classList.add('on'));
      if (count) count.textContent = String(visible().length);
      return;
    }
    let ticking = false;
    let last = -1;
    const update = () => {
      ticking = false;
      if (!scene.isConnected) return;
      const r = scene.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
      steps.forEach((s, i) => s.classList.toggle('on', p >= [0, 0.18, 0.36][i]));
      const shown = visible();
      const lit = p < 0.36 ? 1 : Math.max(1, Math.round(((p - 0.36) / 0.56) * shown.length));
      const n = Math.min(shown.length, lit);
      if (n === last) return;
      last = n;
      shown.forEach((piece, i) => piece.classList.toggle('on', i < n));
      if (count) count.textContent = String(n);
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
    update();
  };
  document.addEventListener('astro:page-load', setup);
</script>
