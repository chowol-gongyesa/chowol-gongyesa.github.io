---
// 자동 로구로와 손 로구로 비교: 두 기계가 실제로 깎는 짧은 영상(화면에 들어오면 소리 없이 반복 재생),
// 작업 사진 두 장씩, 그리고 수량·깎는 방식·잘 맞는 주문을 나란히 비교한 표.
// 영상: public/video/auto-loop.mp4, hand-loop.mp4 (작업 영상에서 잘라 낸 것)
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import { photo } from '~/data/works';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = 'sec-paper2' } = Astro.props;
const m = useT(lang).compare;
const SIDES = [
  { key: 'auto' as const, video: '/video/auto-loop.mp4', poster: '/video/auto-poster.jpg', photos: ['chowol-06', 'chowol-08'] },
  { key: 'hand' as const, video: '/video/hand-loop.mp4', poster: '/video/hand-poster.jpg', photos: ['chowol-03', 'column-04'] },
];
---

<section id="lathes" class={`relative px-5 py-20 md:py-28 lg:px-8 ${className}`} aria-labelledby="lathes-title">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="lathes-title" class="display text-[clamp(2.2rem,4.8vw,3.8rem)] text-ink" data-split>{m.title}</h2>
      <p class="mt-5 text-ink-soft">{m.lead}</p>
    </div>

    <div class="relative mt-14 grid gap-14 md:grid-cols-2 md:gap-10 lg:gap-16">
      <span
        class="seal absolute top-[12rem] left-1/2 z-10 hidden -translate-x-1/2 md:inline-grid"
        style="--seal:3.6rem;writing-mode:horizontal-tb;font-size:1rem"
        aria-hidden="true">{m.or}</span
      >
      {
        SIDES.map((side, i) => {
          const s = m[side.key];
          return (
            <article class="flex flex-col" data-reveal>
              <div class="frame">
                <div class="inner wipe relative aspect-[4/5] md:aspect-square" style={`--d:${i * 0.15}s`}>
                  <video
                    class="lathe-loop h-full w-full object-cover"
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster={side.poster}
                    data-src={side.video}
                    aria-label={s.videoLabel}
                  />
                  <button
                    type="button"
                    class="loop-toggle absolute right-3 bottom-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-night/70 text-wood hover:bg-night"
                    aria-label={m.videoPause}
                    data-label-pause={m.videoPause}
                    data-label-play={m.videoPlay}
                  >
                    <Icon name="tabler:player-pause" class="icon-pause h-5 w-5" aria-hidden="true" />
                    <Icon name="tabler:player-play" class="icon-play hidden h-5 w-5" aria-hidden="true" />
                  </button>
                  <span class="plaque absolute top-4 left-4 text-[1.15rem] md:text-[1.3rem]">{s.name}</span>
                </div>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-3">
                {side.photos.map((file) => {
                  const p = photo(file, lang);
                  return (
                    <div class="photo aspect-[4/3]">
                      <Image
                        src={p.src}
                        alt={p.alt}
                        widths={[240, 400]}
                        sizes="(max-width: 767px) 44vw, 300px"
                        width={400}
                        height={300}
                        layout="cover"
                        format="webp"
                        class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                      />
                    </div>
                  );
                })}
              </div>
              <h3 class="display rise mt-7 text-[1.85rem] text-ink" style="--d:0.2s">
                {s.sub}
              </h3>
              <p class="rise mt-3 text-ink-soft" style="--d:0.3s">
                {s.text}
              </p>
            </article>
          );
        })
      }
    </div>

    <div class="mt-16 overflow-x-auto" data-reveal>
      <table class="rise w-full min-w-[34rem] border-collapse text-left">
        <thead>
          <tr class="border-b-2 border-ink">
            <th scope="col" class="w-[22%] py-3 pr-4 font-normal text-muted"><span class="sr-only">{m.title}</span></th>
            <th scope="col" class="display py-3 pr-4 text-[1.3rem] font-normal text-ink">{m.auto.name}</th>
            <th scope="col" class="display py-3 text-[1.3rem] font-normal text-ink">{m.hand.name}</th>
          </tr>
        </thead>
        <tbody>
          {
            m.rows.map((row) => (
              <tr class="border-b border-ink/15">
                <th scope="row" class="py-4 pr-4 align-top text-[0.95rem] font-bold text-verm">
                  {row.label}
                </th>
                <td class="py-4 pr-4 align-top text-ink">{row.auto}</td>
                <td class="py-4 align-top text-ink">{row.hand}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  const setup = () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLVideoElement>('video.lathe-loop:not([data-ready])').forEach((video) => {
      video.dataset.ready = '1';
      const toggle = video.parentElement?.querySelector<HTMLButtonElement>('.loop-toggle');
      let userPaused = reduce;
      const sync = () => {
        toggle?.setAttribute('aria-label', userPaused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!);
        toggle?.querySelector('.icon-pause')?.classList.toggle('hidden', userPaused);
        toggle?.querySelector('.icon-play')?.classList.toggle('hidden', !userPaused);
      };
      const play = () => {
        if (!video.src) video.src = video.dataset.src!;
        video.play().catch(() => {});
      };
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && !userPaused) play();
          else video.pause();
        },
        { threshold: 0.35 }
      ).observe(video);
      toggle?.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) video.pause();
        else play();
        sync();
      });
      sync();
    });
  };
  document.addEventListener('astro:page-load', setup);
</script>
