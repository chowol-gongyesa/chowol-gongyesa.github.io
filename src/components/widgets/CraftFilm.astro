---
// 작업 영상 '소리 대신 눈으로' (1분, v4). 시끄러운 기계 소리 → 소리가 사라지고 → 눈으로 일하는 장인 → 결을 읽는 40년의 감각
// → 견본은 손으로, 수량은 자동 로구로로 → 만드는 것 → 이름 → '같은 모양을, 한결같이' → 상호·전화.
// 화면에 들어오면 저절로 재생(큰 화면)되고, 사이트 소리가 켜짐(기본)이면 소리와 함께 나옵니다(사용자 요청 2026-11-21).
// 브라우저가 소리를 막으면(아직 화면을 한 번도 누르지 않음) 소리 없이 재생하다가, 화면을 처음 누르는 순간 소리를 켭니다.
// '소리 켜고 처음부터'를 누르면 처음부터 소리와 함께 봅니다. 사이트 소리를 끄면(상단 소리 단추) 영상 소리도 꺼집니다.
// 자막·상호는 영상에 새기지 않고 사이트가 영상 위에 글자로 겹쳐 보여 줌 → 언어마다 자막이 바뀌고, 문구는 src/i18n/ 의 film.cues.
// 자막이 나오는 동안 영상 가운데를 살짝 어둡게 해서(.film-dim) 글씨가 잘 보이게 합니다.
// 아래 CUES·CHAPTER_TIMES의 숫자는 영상 속 시간(초)입니다. 영상을 다시 만들면 design-preview/film-v3/film4.py의 FILM과 맞추세요.
// 영상: public/video/chowol-film.mp4(가로 16:9), chowol-film-mobile.mp4(휴대폰 4:5)
// 휴대폰에서는 데이터를 아끼려고 저절로 재생하지 않고, 재생 단추를 눌러야 받습니다.
import { Icon } from 'astro-icon/components';
import { getAsset } from '~/utils/permalinks';
import { SHOP } from '~/data/shop';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
  /** 소개 페이지처럼 제목을 작게 */
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const f = useT(lang).film;
const c = f.cues;

// kind: line = 가운데 큰 글귀, motto = 구호(더 크게), word = 만드는 것 이름(사진마다), name = 이름(왼쪽 아래), end = 상호·전화
// dim = 그동안 영상 가운데를 어둡게 하는 정도
type Cue = { start: number; end: number; kind: 'line' | 'motto' | 'word' | 'name' | 'end'; lines?: string[]; small?: string; big?: string; tel?: string; sms?: string; dim: number };
const L = (x: string | string[]) => (Array.isArray(x) ? x : [x]);
const line = (start: number, end: number, x: string | string[]): Cue => ({ start, end, kind: 'line', lines: L(x), dim: 1 });
const CUES: Cue[] = [
  line(5.4, 7.4, c.silence),
  line(7.8, 9.9, c.grain),
  line(10.5, 14.7, c.eyes),
  line(15.4, 19.6, c.woods),
  line(20.4, 24.6, c.follow),
  line(25.4, 29.6, c.know),
  line(30.4, 32.4, c.sample),
  line(32.7, 34.9, c.copy),
  line(35.3, 37.4, c.same),
  ...c.words.map((text, i): Cue => ({ start: 37.6 + i * 1.25, end: 38.7 + i * 1.25, kind: 'word', lines: [text], dim: 0.75 })),
  line(45.3, 47.6, c.home),
  { start: 47.8, end: 49.9, kind: 'name', big: c.owner.big, small: c.owner.small, dim: 0.5 },
  { start: 50.4, end: 54.7, kind: 'motto', lines: L(c.motto), dim: 1 },
  // 영상이 끝난 뒤에도 상호와 전화번호가 남도록 끝 시간을 영상 길이(60초)보다 길게
  { start: 55.4, end: 61, kind: 'end', small: c.endSmall, tel: c.endTel, sms: c.endSms, dim: 0.7 },
];
const CHAPTER_TIMES = [0, 15.0, 30.0, 37.5, 47.5, 50.0];
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
---

<section id="film" class="sec-night grain relative overflow-clip py-20 md:py-28" aria-labelledby="film-title">
  <div class="relative z-[2] mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2 id="film-title" class:list={['display mt-4', compact ? 'text-[clamp(2rem,4vw,3rem)]' : 'text-[clamp(2.2rem,4.6vw,3.6rem)]']} data-split>
        {f.title}
      </h2>
    </div>

    <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-10 lg:mt-12 lg:grid-cols-[minmax(0,1.12fr)_minmax(0,0.88fr)] lg:gap-14">
      <!-- 큰 화면: 오른쪽 설명을 읽는 동안 영상이 따라 내려옴 -->
      <div class="min-w-0 lg:sticky lg:top-24 lg:self-start">
        <div class="frame" data-reveal>
          <div
            class="inner film-frame aspect-[4/5] w-full md:aspect-video"
            data-film
            data-label-play={f.resume}
            data-label-pause={f.pause}
            data-label-mute={f.mute}
            data-label-unmute={f.unmute}
          >
            <video
              playsinline
              muted
              preload="none"
              poster={getAsset("/video/chowol-film-poster.jpg")}
              aria-label={f.label}
              data-src-wide={getAsset("/video/chowol-film.mp4")}
              data-src-tall={getAsset("/video/chowol-film-mobile.mp4")}
              data-poster-tall={getAsset("/video/chowol-film-mobile-poster.jpg")}></video>

            <div class="film-dim" aria-hidden="true"></div>
            {
              CUES.map((cue) => (
                <div class="film-cue" data-kind={cue.kind} data-start={cue.start} data-end={cue.end} data-dim={cue.dim} aria-hidden="true">
                  {cue.kind === 'end' ? (
                    <>
                      <span class="cue-lock">
                        <img class="cue-word" src={getAsset("/brand/name-brush.svg")} alt={SHOP.name} width="631" height="207" loading="lazy" decoding="async" />
                        <span class="seal cue-seal" aria-hidden="true">초월</span>
                      </span>
                      <span class="cue-small">{cue.small}</span>
                      <span class="cue-tel">{cue.tel}</span>
                      <span class="cue-sms">{cue.sms}</span>
                    </>
                  ) : cue.kind === 'name' ? (
                    <>
                      <span class="cue-big">{cue.big}</span>
                      <span class="cue-small">{cue.small}</span>
                    </>
                  ) : (
                    cue.lines!.map((l) => <span class="cue-line">{l}</span>)
                  )}
                </div>
              ))
            }

            <button type="button" class="film-bigplay" data-bigplay aria-label={f.play}>
              <span><Icon name="tabler:player-play-filled" class="ml-1 h-8 w-8" aria-hidden="true" /></span>
            </button>
            <button
              type="button"
              class="film-unmute absolute top-4 right-4 z-[6] hidden min-h-11 items-center gap-2 rounded-full px-4 text-[0.95rem] font-bold text-bg shadow-lg"
              style="background-image:linear-gradient(180deg,#f0d79f,#b48b45)"
              data-unmute
            >
              <Icon name="tabler:volume" class="h-5 w-5" aria-hidden="true" />{f.unmuteStart}
            </button>
          </div>
        </div>

        <!-- 조작 단추 -->
        <div class="mt-4 flex flex-wrap items-center gap-2 md:gap-3" data-film-controls>
          <button type="button" class="film-btn" data-toggle aria-label={f.resume}>
            <Icon name="tabler:player-play" class="icon-play h-5 w-5" aria-hidden="true" />
            <Icon name="tabler:player-pause" class="icon-pause hidden h-5 w-5" aria-hidden="true" />
          </button>
          <span class="mr-auto w-[6.2rem] text-center text-[0.95rem] tabular-nums text-ivory-2 sm:mr-0" data-time>0:00 / 1:00</span>
          <input
            type="range"
            class="film-seek max-sm:order-first max-sm:basis-full sm:min-w-[5rem] sm:flex-1"
            min="0"
            max="60"
            step="0.1"
            value="0"
            aria-label={f.seek}
            data-seek
          />
          <button type="button" class="film-btn" data-mute aria-label={f.unmute}>
            <Icon name="tabler:volume-off" class="icon-off h-5 w-5" aria-hidden="true" />
            <Icon name="tabler:volume" class="icon-on hidden h-5 w-5" aria-hidden="true" />
          </button>
          <button type="button" class="film-btn" data-subs data-on={f.subsOff} data-off={f.subsOn}>
            <Icon name="tabler:badge-cc" class="h-5 w-5" aria-hidden="true" /><span class="max-sm:sr-only">{f.subsOff}</span>
          </button>
          <button type="button" class="film-btn" data-fullscreen aria-label={f.fullscreen}>
            <Icon name="tabler:maximize" class="h-5 w-5" aria-hidden="true" />
          </button>
        </div>

        <!-- 휴대폰·태블릿: 영상 바로 아래 장면 바로 보기 단추 (금빛 재생 동그라미 = 누르는 곳) -->
        <div class="mt-6 lg:hidden">
          <p class="font-bold text-gold">{f.chaptersTitle}</p>
          <p class="mt-0.5 text-[0.95rem] text-ivory-2">{f.chaptersHint}</p>
          <div class="scroll-gold -mx-5 mt-3 flex snap-x scroll-px-5 gap-2 overflow-x-auto px-5 pb-2">
            {
              f.chapters.map((ch, i) => (
                <button type="button" class="chapter-chip snap-start" data-chapter={CHAPTER_TIMES[i]}>
                  <span class="chip-play" aria-hidden="true">
                    <Icon name="tabler:player-play-filled" class="h-3.5 w-3.5" />
                  </span>
                  <span class="tabular-nums text-gold-2">{fmt(CHAPTER_TIMES[i])}</span>
                  {ch.title}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- 영상 설명 + 장면 목록 -->
      <div>
        <div class="space-y-4 text-[1.05rem] leading-[1.9] text-ivory-2">
          {f.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <!-- 큰 화면: 장면 바로 보기 — 한 줄 한 줄이 단추 (왼쪽 금빛 재생 동그라미, 올리면 밝아짐, 지금 장면은 금빛) -->
        <div class="mt-9 hidden lg:block">
          <p class="font-bold text-gold">{f.chaptersTitle}</p>
          <p class="mt-1 text-[0.95rem] text-ivory-2">{f.chaptersHint}</p>
        </div>
        <ol class="chapter-list mt-4 hidden lg:grid" data-chapters>
          {
            f.chapters.map((ch, i) => (
              <li>
                <button type="button" class="chapter" data-chapter={CHAPTER_TIMES[i]}>
                  <span class="chapter-play" aria-hidden="true">
                    <Icon name="tabler:player-play-filled" class="h-4 w-4" />
                  </span>
                  <span class="min-w-0">
                    <span class="chapter-head">
                      <strong>{ch.title}</strong>
                      <span class="t">{fmt(CHAPTER_TIMES[i])}</span>
                    </span>
                    <span class="chapter-text">{ch.text}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <!-- 화면 읽기 프로그램용 자막 전문 -->
    <ol class="sr-only">
      {CUES.map((cue) => <li>{cue.lines ? cue.lines.join(' ') : cue.kind === 'end' ? `${SHOP.name}, ${cue.small}, ${cue.tel}, ${cue.sms}` : `${cue.big}, ${cue.small}`}</li>)}
    </ol>
  </div>
</section>

<script>
  // @ts-nocheck — 짧은 화면 조작 코드라 타입 표시 없이 씀
  // 이 스크립트는 문서마다 한 번만 돎(페이지를 옮겨도 다시 돌지 않음). 영상이 있는 페이지에 올 때마다 astro:page-load로 setup
  const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  let cleanup = null;
  const setup = () => {
    const frame = document.querySelector('[data-film]');
    if (!frame || frame.dataset.ready) return;
    frame.dataset.ready = '1';
    const labels = {
      play: frame.dataset.labelPlay,
      pause: frame.dataset.labelPause,
      mute: frame.dataset.labelMute,
      unmute: frame.dataset.labelUnmute,
    };
    const video = frame.querySelector('video');
    const controls = document.querySelector('[data-film-controls]');
    const chapters = [...document.querySelectorAll('[data-chapter]')];
    const cues = [...frame.querySelectorAll('.film-cue')].map((el) => ({
      el,
      start: Number(el.dataset.start),
      end: Number(el.dataset.end),
      dim: Number(el.dataset.dim || 0),
    }));
    const btnToggle = controls.querySelector('[data-toggle]');
    const btnMute = controls.querySelector('[data-mute]');
    const btnSubs = controls.querySelector('[data-subs]');
    const btnFull = controls.querySelector('[data-fullscreen]');
    const seek = controls.querySelector('[data-seek]');
    const time = controls.querySelector('[data-time]');
    const bigplay = frame.querySelector('[data-bigplay]');
    const unmute = frame.querySelector('[data-unmute]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = navigator.connection && navigator.connection.saveData;
    const tall = window.matchMedia('(max-width: 767px)').matches;
    if (tall) video.poster = video.dataset.posterTall;
    let loaded = false;
    let userPaused = false;
    let subs = true;
    let seeking = false;
    // 소리: 사이트 소리 설정(기본 켜짐)을 따름. userMuted = 이 영상의 소리 단추로 직접 끔, blocked = 브라우저가 막아 소리 없이 재생 중
    let userMuted = false;
    let blocked = false;
    const sitePref = () => (window.cwSound && window.cwSound.get ? window.cwSound.get() : true);
    const wantSound = () => sitePref() && !userMuted;
    // 이 문서에서 사람이 한 번이라도 눌렀는지 (안 눌렀으면 소리 나는 재생은 막히므로 처음부터 소리 없이)
    const mayHaveSound = () => !navigator.userActivation || navigator.userActivation.hasBeenActive;

    const ensureSrc = () => {
      if (loaded) return;
      loaded = true;
      video.src = tall ? video.dataset.srcTall : video.dataset.srcWide;
      video.preload = 'auto';
    };
    // 배경 음악에 알림: 영상 소리가 나는 동안 배경 음악을 줄임
    let lastSound = null;
    const tellSound = () => {
      const audible = !video.paused && !video.ended && !video.muted;
      if (audible === lastSound) return;
      lastSound = audible;
      window.dispatchEvent(new CustomEvent('cw:film-sound', { detail: { on: audible } }));
    };
    const syncButtons = () => {
      const playing = !video.paused && !video.ended;
      frame.classList.toggle('is-playing', playing || (loaded && !video.ended && video.currentTime > 0));
      btnToggle.setAttribute('aria-label', playing ? labels.pause : labels.play);
      btnToggle.querySelector('.icon-play').classList.toggle('hidden', playing);
      btnToggle.querySelector('.icon-pause').classList.toggle('hidden', !playing);
      btnMute.setAttribute('aria-label', video.muted ? labels.unmute : labels.mute);
      btnMute.querySelector('.icon-off').classList.toggle('hidden', !video.muted);
      btnMute.querySelector('.icon-on').classList.toggle('hidden', video.muted);
      unmute.classList.toggle('hidden', !(playing && video.muted));
      unmute.classList.toggle('inline-flex', playing && video.muted);
      tellSound();
    };
    const showCues = () => {
      const t = video.currentTime;
      let dim = 0;
      for (const cue of cues) {
        const on = subs && t >= cue.start && t < cue.end;
        cue.el.classList.toggle('is-on', on);
        if (on) dim = Math.max(dim, cue.dim);
      }
      frame.style.setProperty('--cue-dim', String(dim));
      if (!seeking) seek.value = String(t);
      time.textContent = `${fmt(t)} / ${fmt(video.duration || 60)}`;
      // 지금 장면 표시 (오른쪽 목록과 휴대폰 장면 단추 모두)
      let cur = -1;
      chapters.forEach((ch) => {
        const at = Number(ch.dataset.chapter);
        if (t >= at - 0.05 && at > cur) cur = at;
      });
      chapters.forEach((ch) => ch.classList.toggle('is-current', Number(ch.dataset.chapter) === cur && t > 0));
    };
    const loop = () => {
      showCues();
      if (!video.paused && !video.ended) requestAnimationFrame(loop);
    };
    video.addEventListener('play', () => {
      requestAnimationFrame(loop);
      syncButtons();
    });
    video.addEventListener('pause', syncButtons);
    video.addEventListener('volumechange', syncButtons);
    video.addEventListener('loadedmetadata', () => {
      seek.max = String(video.duration);
      showCues();
    });
    video.addEventListener('timeupdate', showCues);
    video.addEventListener('ended', () => {
      frame.classList.remove('is-playing');
      userPaused = true;
      syncButtons();
    });

    // 재생. withSound면 소리와 함께 — 막히면 소리 없이 재생하고, 화면을 처음 누를 때 소리를 켬(아래 unblock)
    const start = (withSound) => {
      ensureSrc();
      if (video.ended) video.currentTime = 0;
      userPaused = false;
      const audible = withSound && mayHaveSound();
      video.muted = !audible;
      blocked = withSound && !audible;
      video.play().catch(() => {
        if (video.muted) return;
        blocked = true;
        video.muted = true;
        video.play().catch(() => {});
      });
    };
    bigplay.addEventListener('click', () => {
      userMuted = false;
      start(true);
    });
    // 소리 없이 저절로 재생되던 중이면, 소리를 켜고 처음부터 (이 영상은 첫 5초의 기계 소리가 사라지는 순간이 중요해서)
    unmute.addEventListener('click', (e) => {
      e.stopPropagation();
      if (video.currentTime > 4) video.currentTime = 0;
      userMuted = false;
      blocked = false;
      video.muted = false;
    });
    btnToggle.addEventListener('click', () => {
      if (video.paused || video.ended) start(wantSound());
      else {
        userPaused = true;
        video.pause();
      }
    });
    video.addEventListener('click', () => {
      if (!video.paused) {
        userPaused = true;
        video.pause();
      } else start(wantSound());
    });
    btnMute.addEventListener('click', () => {
      video.muted = !video.muted;
      userMuted = video.muted;
      blocked = false;
      if (video.paused && !video.muted) start(true);
    });
    // 소리가 막혀 소리 없이 돌던 중이면, 화면 아무 데나 처음 누르는 순간 소리를 켬 (영상의 단추들은 각자 처리)
    const unblock = (e) => {
      if (!blocked || video.paused || !wantSound()) return;
      if (e.target && e.target.closest && e.target.closest('[data-film], [data-film-controls], .sound-toggle')) return;
      blocked = false;
      video.muted = false;
    };
    ['click', 'keydown', 'touchend'].forEach((type) => document.addEventListener(type, unblock, { capture: true, passive: true }));
    // 사이트 소리를 끄면 영상도 소리를 끄고, 켜면 (재생 중일 때) 다시 켬
    const onSite = (e) => {
      const on = !!(e.detail && e.detail.on);
      if (!on) {
        blocked = false;
        video.muted = true;
      } else if (!userMuted && !video.paused) {
        blocked = false;
        video.muted = false;
      }
    };
    window.addEventListener('cw:sound', onSite);
    btnSubs.addEventListener('click', () => {
      subs = !subs;
      const label = btnSubs.querySelector('span');
      if (label) label.textContent = subs ? btnSubs.dataset.on : btnSubs.dataset.off;
      showCues();
    });
    seek.addEventListener('input', () => {
      seeking = true;
      ensureSrc();
      video.currentTime = Number(seek.value);
      showCues();
    });
    seek.addEventListener('change', () => (seeking = false));
    btnFull.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else if (frame.requestFullscreen) frame.requestFullscreen().catch(() => {});
      else if (video.webkitEnterFullscreen) video.webkitEnterFullscreen();
    });
    chapters.forEach((ch) =>
      ch.addEventListener('click', () => {
        ensureSrc();
        const go = () => {
          video.currentTime = Number(ch.dataset.chapter);
          start(wantSound());
        };
        if (video.readyState >= 1) go();
        else video.addEventListener('loadedmetadata', go, { once: true });
        // 영상과 조작 단추가 머리·아래 띠에 가리지 않게 (머리 높이만큼 띄우는 것은 tailwind.css의 html scroll-padding-top)
        const r = frame.getBoundingClientRect();
        const short = window.innerWidth < 1024;
        if (short || r.top < 0 || r.bottom > window.innerHeight)
          frame.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: short ? 'start' : 'center' });
      })
    );

    // 화면에 절반쯤 들어오면 소리 없이 재생(큰 화면만), 벗어나면 멈춤
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const auto = !reduce && !saveData && !coarse;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !userPaused && (auto || loaded)) {
          if (video.paused) start(wantSound());
        } else if (!entry.isIntersecting && !video.paused) {
          video.pause();
          // 휴대폰에서는 화면 밖으로 나가 멈추면, 다시 와도 소리와 함께 저절로 시작하지 않게
          if (coarse) userPaused = true;
        }
      },
      { threshold: 0.5 }
    );
    io.observe(frame);
    cleanup = () => {
      io.disconnect();
      ['click', 'keydown', 'touchend'].forEach((type) => document.removeEventListener(type, unblock, { capture: true }));
      window.removeEventListener('cw:sound', onSite);
    };
    syncButtons();
  };
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
    window.dispatchEvent(new CustomEvent('cw:film-sound', { detail: { on: false } }));
  });
</script>
