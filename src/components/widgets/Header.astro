---
// 상단 메뉴: 밤 작업장 같은 짙은 쪽빛 띠. 컴퓨터는 한 줄(로고, 메뉴, 언어, 상담전화),
// 휴대폰은 로고 줄 아래에 옆으로 밀리는 메뉴 탭이 붙습니다.
// 홈에서는 첫 화면 영상 위에 투명하게 떠 있다가 스크롤하면 짙어집니다 (tailwind.css의 html.header-over).
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import LangSwitch from '~/components/common/LangSwitch.astro';
import { localize, useT, type Lang } from '~/i18n';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
}

export interface Props {
  id?: string;
  links?: Array<Link>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  lang?: Lang;
}

const { id = 'header', links = [], actions = [], isSticky = false, lang = 'ko' } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const t = useT(lang);
const callAction = actions.find((action) => String(action.href ?? '').startsWith('tel:'));
const contactHref = localize(lang, '/contact');
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

// 상단 메뉴는 페이지를 옮겨도 그대로 남김(transition:persist). 언어가 바뀌면 새로 그리도록 이름에 언어를 넣음
const persistKey = `header-${lang}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[{ sticky: isSticky, relative: !isSticky }, 'top-0 z-40 w-full flex-none transition-shadow']}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="relative">
      <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 lg:px-6 lg:py-3.5">
        <a class="flex min-h-11 items-center" href={localize(lang, '/')} translate="no" aria-label={t.brand}>
          <Logo lang={lang} />
        </a>

        <nav class="desktop-nav hidden lg:flex" aria-label={t.nav.main}>
          <ul class="flex items-center text-[0.98rem] font-medium">
            {
              links.map(({ text, href }) => (
                <li>
                  <a
                    class:list={['flex min-h-11 items-center px-[0.9rem] whitespace-nowrap', { 'aw-link-active': isActive(href) }]}
                    href={href}
                  >
                    {text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          <LangSwitch lang={lang} />
          {
            callAction && (
              <>
                <a href={callAction.href} class="btn-verm hidden !min-h-11 !px-5 text-[0.95rem] lg:inline-flex">
                  <Icon name="tabler:phone" class="h-5 w-5" aria-hidden="true" />
                  {callAction.text}
                </a>
                <a
                  href={callAction.href}
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-verm text-white lg:hidden"
                  aria-label={callAction.text}
                >
                  <Icon name="tabler:phone" class="h-5 w-5" />
                </a>
              </>
            )
          }
        </div>
      </div>
    </div>

    <!-- 휴대폰·태블릿: 늘 보이는 메뉴 탭 (옆으로 밀어서 넘김) -->
    <nav class="mobile-tabs relative lg:hidden" aria-label={t.nav.main}>
      <ul class="mobile-tabs-list">
        {
          links.map(({ text, href }) => (
            <li>
              <a
                class:list={['mobile-tab', { 'is-cta': href === contactHref, 'aw-link-active': isActive(href) }]}
                href={href}
              >
                {href === contactHref && <Icon name="tabler:clipboard-text" class="h-4 w-4" aria-hidden="true" />}
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.revealActiveTab();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      // 상단 메뉴는 페이지를 옮겨도 남아 있으므로, 페이지가 바뀔 때마다 지금 페이지 표시를 다시 맞춤
      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          header.classList.toggle('scroll', window.scrollY > 20);
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    // 휴대폰 탭 줄에서 지금 페이지 탭이 화면 밖에 있으면 가운데로 밀어 보여 줌
    private revealActiveTab() {
      const list = this.querySelector<HTMLElement>('.mobile-tabs-list');
      const active = list?.querySelector<HTMLElement>('.aw-link-active');
      if (!list || !active) return;
      const cta = list.querySelector<HTMLElement>('li:has(> .is-cta)');
      const visible = list.clientWidth - (cta && !cta.contains(active) ? cta.offsetWidth : 0);
      const left = active.offsetLeft - (visible - active.offsetWidth) / 2;
      list.scrollTo({ left: Math.max(0, left), behavior: 'instant' });
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        const isPathLink = url.origin === window.location.origin && !url.hash;
        a.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
        if (isPathLink && norm(url.pathname) === current) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
