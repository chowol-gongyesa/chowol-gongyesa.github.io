---
// 주문 순서 4단계 (홈, 만드는 것 페이지에서 함께 씀). 문구는 src/i18n/*.ts의 steps
import { langFromPath, useT } from '~/i18n';

export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const s = useT(langFromPath(Astro.url.pathname)).steps;
---

<section class={`px-4 py-16 md:py-24 lg:px-6 ${className}`}>
  <div class="mx-auto max-w-7xl">
    <h2 class="display text-[clamp(2rem,4vw,3rem)] text-ink">{s.title}</h2>
    <ol class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.items.map((item, index) => (
          <li class="border-t-2 border-ink pt-5">
            <span class="step-num block text-[3.25rem] text-sign" aria-hidden="true">
              {index + 1}
            </span>
            <h3 class="mt-3 text-xl font-bold text-ink">
              <span class="sr-only">{index + 1}. </span>
              {item.title}
            </h3>
            <p class="mt-2 text-muted">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
