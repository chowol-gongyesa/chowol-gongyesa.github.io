---
// 주문 순서 4단계. 화면에 들어오면 주홍 선이 왼쪽에서 오른쪽으로 그어지고 단계가 차례로 떠오름.
import { langFromPath, useT } from '~/i18n';

export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const t = useT(langFromPath(Astro.url.pathname));
---

<section class={`px-5 py-20 md:py-28 lg:px-8 ${className}`} aria-labelledby="steps-title">
  <div class="mx-auto max-w-7xl">
    <h2 id="steps-title" class="display text-[clamp(2.2rem,4.8vw,3.8rem)] text-ink" data-split>{t.steps.title}</h2>
    <div class="relative mt-12" data-reveal>
      <div class="steps-line hidden md:block" aria-hidden="true"></div>
      <ol class="relative grid gap-10 md:grid-cols-4 md:gap-8">
        {
          t.steps.items.map((step, i) => (
            <li class="rise flex gap-5 md:block" style={`--d:${0.2 + i * 0.25}s`}>
              <span class="step-num shrink-0">{i + 1}</span>
              <div>
                <h3 class="display mt-1 text-[1.45rem] text-ink md:mt-6">{step.title}</h3>
                <p class="mt-2 text-ink-soft">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
