---
// 입장 화면 (홈, 같은 방문 중 한 번만) — 7.6초짜리 예고편. 누르지 않아도 저절로 사이트로 넘어갑니다.
//  0.0초  어둠 속에서 느린 화면: 깎여 나가는 나무        글귀 ① '로구로 40년'
//  1.6초  장인의 눈 (안경 너머)                           글귀 ② '소리 대신, 눈으로'
//  3.0초  손 → 빠른 컷 셋 (자동 로구로, 깎이는 나무)
//  5.0초  번쩍 + 큰 울림, 나무 글자 상호 '초월공예사'가 크게 나타남
//  7.6초  위아래 검은 띠가 열리며 첫 화면으로
// 화면을 누르거나 '건너뛰기'를 누르면 바로 들어갑니다. '소리 켜기'를 누르면 예고편 소리가 나고, 들어간 뒤 배경 음악이 이어집니다.
// 영상: public/video/intro-trailer.mp4(가로) · intro-trailer-m.mp4(휴대폰 세로). 만드는 도구 design-preview/film-v3/ (film4.py trailer-*)
// 글귀는 src/i18n/ 의 intro. 시간을 바꾸면 영상(film4.py의 TRAILER_SHOTS)과 같이 바꾸세요.
import { Icon } from 'astro-icon/components';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang).intro;
const END = 7.6;
---

<div id="intro" role="dialog" aria-modal="true" aria-label={t.label} data-intro data-end={END}>
  <video
    class="intro-video"
    muted
    playsinline
    preload="auto"
    aria-hidden="true"
    data-src-wide="/video/intro-trailer.mp4"
    data-src-tall="/video/intro-trailer-m.mp4"
    data-poster-wide="/video/intro-trailer-poster.jpg"
    data-poster-tall="/video/intro-trailer-poster-m.jpg"></video>
  <div class="intro-shade" aria-hidden="true"></div>
  <div class="intro-bar intro-bar-top" aria-hidden="true"></div>
  <div class="intro-bar intro-bar-bottom" aria-hidden="true"></div>

  <p class="intro-beat" data-at="0.45" data-out="1.5">{t.beat1}</p>
  <p class="intro-beat" data-at="1.85" data-out="3.35">{t.beat2}</p>
  <div class="intro-title" data-at="5.05">
    <img src="/brand/wordmark.webp" alt="초월공예사" width="1280" height="284" />
    <p>{t.sub}</p>
  </div>

  <div class="intro-ui">
    <button type="button" class="intro-btn" data-intro-sound aria-pressed="false" data-on={t.soundOff} data-off={t.sound}>
      <Icon name="tabler:volume-off" class="icon-off h-5 w-5" aria-hidden="true" />
      <Icon name="tabler:volume" class="icon-on hidden h-5 w-5" aria-hidden="true" />
      <span>{t.sound}</span>
    </button>
    <button type="button" class="intro-btn" data-intro-skip>
      <span>{t.skip}</span>
      <Icon name="tabler:player-track-next" class="h-5 w-5" aria-hidden="true" />
    </button>
  </div>
  <div class="intro-progress" aria-hidden="true"><i></i></div>
</div>

<script is:inline>
  // 같은 방문 중 이미 들어왔으면 그리기 전에 바로 없앰. 처음이면 예고편을 바로 받기 시작
  (function () {
    var el = document.getElementById('intro');
    if (!el) return;
    try {
      if (sessionStorage.getItem('cw-intro')) {
        el.remove();
        return;
      }
    } catch (e) {}
    document.documentElement.classList.add('intro-active');
    var v = el.querySelector('video');
    var tall = window.matchMedia('(max-aspect-ratio: 1/1)').matches;
    v.poster = tall ? v.dataset.posterTall : v.dataset.posterWide;
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.src = tall ? v.dataset.srcTall : v.dataset.srcWide;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  })();
</script>

<script>
  const seen = () => {
    try {
      return !!sessionStorage.getItem('cw-intro');
    } catch {
      return false;
    }
  };
  // 페이지를 옮겨 홈으로 돌아올 때, 그리기 전에 지움
  document.addEventListener('astro:after-swap', () => {
    if (seen()) {
      document.getElementById('intro')?.remove();
      document.documentElement.classList.remove('intro-active');
    }
  });

  const setup = () => {
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    if (!intro || intro.dataset.ready) return;
    if (seen()) {
      intro.remove();
      document.documentElement.classList.remove('intro-active');
      return;
    }
    intro.dataset.ready = '1';
    const END = Number(intro.dataset.end || 7.6);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const video = intro.querySelector<HTMLVideoElement>('video')!;
    const timed = [...intro.querySelectorAll<HTMLElement>('[data-at]')].map((el) => ({
      el,
      at: Number(el.dataset.at),
      out: el.dataset.out ? Number(el.dataset.out) : Infinity,
    }));
    const bar = intro.querySelector<HTMLElement>('.intro-progress i');
    const btnSound = intro.querySelector<HTMLButtonElement>('[data-intro-sound]')!;
    let soundOn = false;
    let closed = false;
    let raf = 0;

    // 시계: 영상이 재생되면 영상 시간. 1.2초가 지나도 영상이 안 나오면(자동 재생이 막힘·느린 인터넷)
    // 포스터 위에서 실제 시간으로 글귀를 진행
    const t0 = performance.now() + 1200;
    let useVideo = false;
    const now = () => (useVideo ? video.currentTime : Math.max(0, (performance.now() - t0) / 1000));
    const onVideo = () => {
      if (useVideo || video.currentTime <= 0) return;
      useVideo = true;
      intro.classList.remove('no-video-yet');
    };
    // 영상은 이 스크립트보다 먼저(위의 inline 스크립트에서) 재생을 시작할 수 있으므로 지금 상태도 확인
    if (!video.paused && video.currentTime > 0) onVideo();
    else intro.classList.add('no-video-yet');
    video.addEventListener('playing', onVideo);
    video.addEventListener('timeupdate', onVideo);

    const tick = () => {
      const t = reduce ? END : now();
      for (const x of timed) x.el.classList.toggle('is-on', t >= x.at && t < x.out);
      intro.classList.toggle('is-impact', t >= 5.0 && t < 5.5);
      if (bar) bar.style.transform = `scaleX(${Math.min(1, t / END)})`;
      if (t >= END) close();
      else raf = requestAnimationFrame(tick);
    };

    const close = () => {
      if (closed) return;
      closed = true;
      cancelAnimationFrame(raf);
      try {
        sessionStorage.setItem('cw-intro', '1');
      } catch {
        /* storage unavailable */
      }
      // 예고편에서 소리를 켰으면 들어간 뒤 배경 음악이 이어짐
      const sound = (window as unknown as { cwSound?: { enter: (on: boolean) => void } }).cwSound;
      sound?.enter(soundOn);
      intro.classList.add('is-out');
      document.documentElement.classList.remove('intro-active');
      window.dispatchEvent(new CustomEvent('cw:intro-closed', { detail: { time: 0 } }));
      document.getElementById('main')?.focus({ preventScroll: true });
      window.setTimeout(() => {
        video.pause();
        intro.remove();
      }, 1300);
    };

    btnSound.addEventListener('click', (e) => {
      e.stopPropagation();
      soundOn = !soundOn;
      video.muted = !soundOn;
      if (soundOn && video.paused && !reduce) video.play().catch(() => {});
      btnSound.setAttribute('aria-pressed', String(soundOn));
      btnSound.querySelector('.icon-off')?.classList.toggle('hidden', soundOn);
      btnSound.querySelector('.icon-on')?.classList.toggle('hidden', !soundOn);
      const label = btnSound.querySelector('span');
      if (label) label.textContent = soundOn ? btnSound.dataset.on! : btnSound.dataset.off!;
    });
    intro.querySelector('[data-intro-skip]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      close();
    });
    // 화면 어디를 눌러도 바로 들어감
    intro.addEventListener('click', close);
    intro.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    window.setTimeout(() => intro.querySelector<HTMLButtonElement>('[data-intro-skip]')?.focus({ preventScroll: true }), 200);
    if (video.ended) close();
    video.addEventListener('ended', close);
    // 영상이 받아지지 않거나 중간에 멈춰도 12초 뒤에는 꼭 들어감
    window.setTimeout(close, 12000);
    raf = requestAnimationFrame(tick);
  };
  document.addEventListener('astro:page-load', setup);
</script>
