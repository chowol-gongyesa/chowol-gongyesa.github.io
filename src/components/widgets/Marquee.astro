---
// 원목 띠 위로 깎는 물건 이름이 천천히 흘러감. 낱말 사이에는 작은 동자 그림.
import { verticalPath } from '~/utils/baluster';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const words = useT(lang).marquee;
const path = verticalPath(3);
---

<div class="sec-wood relative overflow-hidden border-y border-[#8f6a40]/40 py-5 md:py-6" aria-hidden="true">
  <svg width="0" height="0" class="absolute">
    <symbol id="mq-b" viewBox="0 0 36 300"><path d={path} fill="#7a5532"></path></symbol>
  </svg>
  <div class="marquee" style="--speed:55s;--gap:2.2rem">
    {
      [0, 1].map(() => (
        <div class="marquee-track">
          {words.map((word) => (
            <>
              <span class="display whitespace-nowrap text-[1.7rem] text-[#4b3320] [text-shadow:0_1px_0_rgb(255_255_255/0.5)] md:text-[2.1rem]">
                {word}
              </span>
              <svg viewBox="0 0 36 300" class="h-9 w-auto shrink-0 opacity-70 md:h-11">
                <use href="#mq-b" />
              </svg>
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>
