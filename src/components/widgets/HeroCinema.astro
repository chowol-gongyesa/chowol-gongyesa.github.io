---
// 홈 첫 화면: 자동 로구로가 각재를 깎는 실제 영상이 화면 가득 천천히 흐르고,
// 그 위로 등잔불 같은 빛(마우스를 따라 움직임)과 떠다니는 나무 가루, 큰 제목과 낙관.
// 영상: public/video/hero-1280.mp4(가로), hero-540.mp4(휴대폰 세로). 움직임 줄이기 설정이면 정지 사진만.
import { Icon } from 'astro-icon/components';
import Balustrade from '~/components/widgets/Balustrade.astro';
import { shopFor } from '~/data/shop';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const h = t.hero;
const shop = shopFor(lang);
---

<section class="hero-cinema grain" data-hero aria-labelledby="hero-title">
  <picture>
    <source media="(max-width: 767px)" srcset="/video/hero-poster-m.jpg" />
    <img class="hero-poster" src="/video/hero-poster.jpg" alt="" fetchpriority="high" />
  </picture>
  <video
    class="hero-video"
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/hero-poster.jpg"
    aria-label={h.videoLabel}
    data-src-wide="/video/hero-1280.mp4"
    data-src-tall="/video/hero-540.mp4"
    data-poster-tall="/video/hero-poster-m.jpg"></video>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-spot" aria-hidden="true"></div>
  <canvas class="hero-dust" aria-hidden="true"></canvas>

  <div class="relative z-[2] mx-auto flex min-h-[100svh] max-w-7xl flex-col justify-end px-5 pt-28 pb-[12.5rem] lg:px-8">
    <div class="hero-enter max-w-[46rem]">
      <div style="--d:0" class="mb-5 flex items-center gap-4 [@media(max-height:820px)]:hidden">
        <span class="seal is-stamp" style="--seal:3rem;--delay:1.1s">초월</span>
        <span class="ruler-line w-28 text-wood md:w-40"></span>
      </div>
      <h1 id="hero-title" class="display hero-title" style="--d:1">
        <span class="block">{h.title1}</span>
        <span class="block">{h.title2}</span>
      </h1>
      <p style="--d:2" class="mt-6 max-w-[38rem] text-[1.05rem] leading-[1.9] text-paper/88 md:text-[1.1rem]">
        {h.lead}
      </p>
      <div style="--d:3" class="mt-8 flex flex-wrap gap-3">
        <a href={shop.consult.href} class="btn-verm">
          <Icon name="tabler:phone" class="h-5 w-5" aria-hidden="true" />{t.nav.call}
          <span class="tabular-nums">{shop.consult.label}</span>
        </a>
        <a href={shop.mobile.sms} class="btn-ghost">
          <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{h.sms}
        </a>
      </div>
      <ul style="--d:4" class="block-list mt-6 flex flex-wrap gap-x-7 gap-y-2 text-[0.97rem] text-paper/80 [@media(max-height:820px)]:hidden">
        {h.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>
  </div>

  <!-- 오른쪽 가장자리의 세로 글씨 (컴퓨터 화면) -->
  <p class="vtext absolute top-1/2 right-6 z-[2] hidden -translate-y-1/2 text-[1.05rem] text-wood/85 lg:block xl:right-10" aria-hidden="true">
    {h.vlabel}
  </p>

  <div class="absolute inset-x-0 bottom-0 z-[2]">
    <div class="mx-auto flex max-w-7xl items-end justify-end gap-5 px-5 pb-4 lg:px-8">
      <a href="#after-hero" class="scroll-cue pointer-events-auto hidden md:inline-flex" aria-label={h.scroll}>
        <span aria-hidden="true">{h.scroll}</span><i aria-hidden="true"></i>
      </a>
      <button
        type="button"
        class="hero-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-wood/40 text-wood/90 hover:border-wood hover:bg-wood/10"
        aria-label={h.pause}
        data-label-pause={h.pause}
        data-label-play={h.play}
      >
        <Icon name="tabler:player-pause" class="icon-pause h-5 w-5" aria-hidden="true" />
        <Icon name="tabler:player-play" class="icon-play hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
    <Balustrade />
  </div>
</section>
<div id="after-hero"></div>

<script>
  type Mote = { x: number; y: number; r: number; vx: number; vy: number; a: number; tw: number };
  const setup = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || hero.dataset.ready) return;
    hero.dataset.ready = '1';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const video = hero.querySelector<HTMLVideoElement>('.hero-video');
    const toggle = hero.querySelector<HTMLButtonElement>('.hero-toggle');
    let userPaused = reduce;

    // 영상: 화면 모양에 맞는 파일을 고르고, 화면 밖이면 멈춤
    if (video) {
      const tall = window.matchMedia('(max-width: 767px)').matches;
      video.src = tall ? video.dataset.srcTall! : video.dataset.srcWide!;
      if (tall) video.poster = video.dataset.posterTall!;
      video.addEventListener('playing', () => hero.classList.add('is-playing'), { once: true });
      const play = () => {
        if (!userPaused) video.play().catch(() => {});
      };
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : video.pause()), { threshold: 0.05 }).observe(
        hero
      );
      const sync = () => {
        const paused = userPaused;
        toggle?.setAttribute('aria-label', paused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!);
        toggle?.querySelector('.icon-pause')?.classList.toggle('hidden', paused);
        toggle?.querySelector('.icon-play')?.classList.toggle('hidden', !paused);
      };
      toggle?.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) video.pause();
        else video.play().catch(() => {});
        sync();
      });
      sync();
    }

    // 마우스를 따라 움직이는 빛
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
      hero.style.setProperty('--my', `${e.clientY - r.top}px`);
    });

    // 빛 속에 떠다니는 나무 가루
    const canvas = hero.querySelector<HTMLCanvasElement>('.hero-dust');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx || reduce) return;
    let w = 0;
    let h = 0;
    const motes: Mote[] = [];
    const size = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    window.addEventListener('resize', size);
    const count = w < 768 ? 36 : 70;
    for (let i = 0; i < count; i++) {
      motes.push({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.5 + Math.random() * 1.8,
        vx: (Math.random() - 0.5) * 0.15,
        vy: -0.1 - Math.random() * 0.25,
        a: 0.15 + Math.random() * 0.5,
        tw: Math.random() * Math.PI * 2,
      });
    }
    let visible = true;
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) requestAnimationFrame(draw);
    }).observe(hero);
    const draw = () => {
      if (!visible || !hero.isConnected) return;
      ctx.clearRect(0, 0, w, h);
      for (const m of motes) {
        m.tw += 0.02;
        m.x += m.vx + Math.sin(m.tw) * 0.12;
        m.y += m.vy;
        if (m.y < -10) {
          m.y = h + 10;
          m.x = Math.random() * w;
        }
        ctx.globalAlpha = m.a * (0.6 + 0.4 * Math.sin(m.tw * 1.3));
        ctx.fillStyle = '#f3dfb8';
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ctx.fill();
      }
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  };
  document.addEventListener('astro:page-load', setup);
</script>
