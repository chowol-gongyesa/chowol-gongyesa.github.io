---
// 홈 첫 화면: 실제 작업 영상(깎여 나가는 나무 → 자동 로구로 → 손 로구로)이 화면 가득 흐르고,
// 왼쪽에 큰 제목과 연락 단추, 공중에 떠다니는 금빛 나무 가루. 입장 화면과 같은 영상이라 자연스럽게 이어짐.
// 영상: public/video/hero-1280.mp4(가로), hero-540.mp4(휴대폰 세로). 움직임 줄이기 설정이면 정지 사진만.
import { Icon } from 'astro-icon/components';
import { shopFor } from '~/data/shop';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const h = t.hero;
const shop = shopFor(lang);
---

<section class="hero-cinema" data-hero aria-labelledby="hero-title">
  <picture>
    <source media="(max-width: 767px)" srcset="/video/hero-poster-m.jpg" />
    <img class="hero-poster" src="/video/hero-poster.jpg" alt="" fetchpriority="high" />
  </picture>
  <video
    class="hero-video"
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/hero-poster.jpg"
    aria-label={h.videoLabel}
    data-src-wide="/video/hero-1280.mp4"
    data-src-tall="/video/hero-540.mp4"
    data-poster-tall="/video/hero-poster-m.jpg"></video>
  <div class="hero-shade" aria-hidden="true"></div>
  <canvas class="hero-dust" aria-hidden="true"></canvas>

  <div class="relative z-[2] mx-auto flex min-h-[100svh] max-w-7xl flex-col justify-end px-5 pt-32 pb-24 md:pb-28 lg:px-8">
    <div class="hero-enter max-w-[48rem]">
      <p style="--d:0" class="eyebrow">{h.vlabel}</p>
      <h1 id="hero-title" class="display hero-title mt-5" style="--d:1">
        <span class="block">{h.title1}</span>
        <span class="block">{h.title2}</span>
      </h1>
      <p style="--d:2" class="mt-6 max-w-[37rem] text-[1.08rem] leading-[1.9] text-ivory md:text-[1.15rem]">
        {h.lead}
      </p>
      <div style="--d:3" class="mt-8 flex flex-wrap gap-3">
        <a href={shop.consult.href} class="btn-gold w-full sm:w-auto">
          <Icon name="tabler:phone" class="h-5 w-5" aria-hidden="true" />{t.nav.call}
          <span class="tabular-nums">{shop.consult.label}</span>
        </a>
        <a href={shop.mobile.sms} class="btn-ghost w-full sm:w-auto">
          <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{h.sms}
          <!-- 컴퓨터에서는 문자 앱이 안 열릴 수 있어 번호를 함께 보여 줌 -->
          <span class="hidden tabular-nums [@media(hover:hover)_and_(pointer:fine)]:inline">{shop.mobile.label}</span>
        </a>
      </div>
      <ul style="--d:4" class="block-list mt-7 flex flex-wrap gap-x-7 gap-y-2 text-[0.98rem] text-ivory-2 [@media(max-height:760px)]:hidden">
        {h.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 z-[2]">
    <div class="mx-auto flex max-w-7xl items-end justify-end gap-5 px-5 pb-6 lg:px-8">
      <a href="#after-hero" class="scroll-cue hidden md:inline-flex" aria-label={h.scroll}>
        <span aria-hidden="true">{h.scroll}</span><i aria-hidden="true"></i>
      </a>
      <button
        type="button"
        class="hero-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-gold/50 text-gold-2 hover:border-gold-2 hover:bg-gold/10"
        aria-label={h.pause}
        data-label-pause={h.pause}
        data-label-play={h.play}
      >
        <Icon name="tabler:player-pause" class="icon-pause h-5 w-5" aria-hidden="true" />
        <Icon name="tabler:player-play" class="icon-play hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>
</section>
<div id="after-hero"></div>

<script>
  type Mote = { x: number; y: number; r: number; vx: number; vy: number; a: number; tw: number };
  const setup = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || hero.dataset.ready) return;
    hero.dataset.ready = '1';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 휴대폰 '데이터 절약' 설정이면 배경 영상을 저절로 받지 않음(포스터만, 재생 단추로 볼 수 있음)
    const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const video = hero.querySelector<HTMLVideoElement>('.hero-video');
    const toggle = hero.querySelector<HTMLButtonElement>('.hero-toggle');
    let userPaused = reduce || saveData;
    // 다른 페이지로 옮길 때 이 첫 화면이 쓰던 감시·그리기를 정리 (홈에 올 때마다 쌓이지 않게)
    const cleanups: Array<() => void> = [];
    document.addEventListener('astro:before-swap', () => cleanups.splice(0).forEach((fn) => fn()), { once: true });

    if (video) {
      const tall = window.matchMedia('(max-width: 767px)').matches;
      if (tall) video.poster = video.dataset.posterTall!;
      const play = () => {
        if (!userPaused && video.src) video.play().catch(() => {});
      };
      // 입장 화면이 같은 영상을 틀고 있는 동안은 받지 않고(두 번 받지 않게), 입장하면 그 순간부터 이어서 재생
      const start = (time?: number) => {
        if (video.src) return;
        video.src = tall ? video.dataset.srcTall! : video.dataset.srcWide!;
        if (time)
          video.addEventListener(
            'loadedmetadata',
            () => {
              try {
                video.currentTime = time % (video.duration || 9);
              } catch {
                /* not seekable yet */
              }
            },
            { once: true }
          );
        play();
      };
      if (saveData) {
        /* 데이터 절약: 재생 단추를 누를 때만 받음 */
      } else if (document.documentElement.classList.contains('intro-active'))
        window.addEventListener('cw:intro-closed', (e) => start((e as CustomEvent<{ time?: number }>).detail?.time), { once: true });
      else start();
      const videoIo = new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : video.pause()), { threshold: 0.05 });
      videoIo.observe(hero);
      cleanups.push(() => videoIo.disconnect());
      const sync = () => {
        toggle?.setAttribute('aria-label', userPaused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!);
        toggle?.querySelector('.icon-pause')?.classList.toggle('hidden', userPaused);
        toggle?.querySelector('.icon-play')?.classList.toggle('hidden', !userPaused);
      };
      toggle?.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) video.pause();
        else if (!video.src) start();
        else video.play().catch(() => {});
        sync();
      });
      sync();
    }

    // 빛 속에 떠다니는 금빛 나무 가루
    const canvas = hero.querySelector<HTMLCanvasElement>('.hero-dust');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx || reduce) return;
    let w = 0;
    let h = 0;
    const motes: Mote[] = [];
    const size = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    window.addEventListener('resize', size);
    cleanups.push(() => window.removeEventListener('resize', size));
    const count = w < 768 ? 34 : 64;
    for (let i = 0; i < count; i++) {
      motes.push({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.5 + Math.random() * 1.7,
        vx: (Math.random() - 0.5) * 0.15,
        vy: -0.1 - Math.random() * 0.25,
        a: 0.15 + Math.random() * 0.5,
        tw: Math.random() * Math.PI * 2,
      });
    }
    let visible = true;
    let raf = 0;
    const dustIo = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !raf) raf = requestAnimationFrame(draw);
    });
    dustIo.observe(hero);
    cleanups.push(() => {
      dustIo.disconnect();
      cancelAnimationFrame(raf);
      raf = 0;
    });
    const draw = () => {
      raf = 0;
      if (!visible || !hero.isConnected) return;
      ctx.clearRect(0, 0, w, h);
      for (const m of motes) {
        m.tw += 0.02;
        m.x += m.vx + Math.sin(m.tw) * 0.12;
        m.y += m.vy;
        if (m.y < -10) {
          m.y = h + 10;
          m.x = Math.random() * w;
        }
        ctx.globalAlpha = m.a * (0.6 + 0.4 * Math.sin(m.tw * 1.3));
        ctx.fillStyle = '#f0d39b';
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    };
    // 첫 그리기는 IntersectionObserver가 처음 알려 줄 때 시작 (여기서 따로 시작하면 고리가 둘이 됨)
  };
  document.addEventListener('astro:page-load', setup);
</script>
