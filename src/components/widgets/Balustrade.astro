---
// 첫 화면 맨 아래의 난간: 자동 로구로로 깎은 것 같은 똑같은 동자들이 하나씩 내려와 서고, 위에 난간대가 얹힘.
// 동자 모양은 src/utils/baluster.ts (입장 화면·복제 장면과 같은 모양).
import { verticalPath } from '~/utils/baluster';

const COUNT = 22;
const path = verticalPath();
---

<div class="balustrade" aria-hidden="true">
  <svg width="0" height="0" class="absolute">
    <defs>
      <linearGradient id="bl-wood" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#7d5a35"></stop>
        <stop offset="0.28" stop-color="#e2c79a"></stop>
        <stop offset="0.45" stop-color="#f6e8cc"></stop>
        <stop offset="0.7" stop-color="#c9a271"></stop>
        <stop offset="1" stop-color="#5f4226"></stop>
      </linearGradient>
      <symbol id="bl-baluster" viewBox="0 0 36 300">
        <path d={path} fill="url(#bl-wood)"></path>
        <path d={path} fill="none" stroke="rgb(60 40 20 / 0.35)" stroke-width="0.6"></path>
      </symbol>
    </defs>
  </svg>
  <div class="balustrade-rail top"></div>
  <div class="balusters">
    {
      Array.from({ length: COUNT }, (_, i) => (
        <div class="baluster" style={`--i:${i}`}>
          <svg viewBox="0 0 36 300">
            <use href="#bl-baluster" />
          </svg>
        </div>
      ))
    }
  </div>
  <div class="balustrade-rail bottom"></div>
</div>
