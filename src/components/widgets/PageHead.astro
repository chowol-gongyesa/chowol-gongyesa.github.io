---
// 하위 페이지 머리: 위쪽 메뉴에서 이어지는 파란 간판 띠 + '홈 > 페이지' + 큰 제목.
// 아래 가장자리의 원목색 띠는 홈 첫 화면 난간의 손잡이를 줄여 놓은 것입니다.
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { localize, useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  crumb: string;
}
const { lang, title, lead, crumb } = Astro.props;
---

<section class="on-sign">
  <div class="mx-auto max-w-7xl px-4 pt-3 pb-12 md:pb-16 lg:px-6">
    <Breadcrumbs
      class="crumbs -ml-1"
      items={[{ text: useT(lang).nav.home, href: localize(lang, '/'), icon: 'tabler:home' }, { text: crumb }]}
    />
    <h1 class="display mt-6 text-[clamp(2.6rem,6.5vw,4.75rem)] text-white">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-white/85">{lead}</p>}
    <slot />
  </div>
  <div class="rail-strip" aria-hidden="true"></div>
</section>

