---
// 연락 방법 (홈 아래쪽, 주문·문의 페이지 위쪽). 밤 작업장 쪽빛 바탕.
// 큰 번호는 상담전화: 대표님이 소리 대신 글로 소통하셔서 전화는 상담전화가 대신 받습니다.
// 대표 휴대폰은 '문자 보내기'를 먼저 보여 줍니다(전화도 되지만 문자를 부탁).
// 상담전화 카드에는 '초월공예사라고 말씀해 주세요' 안내(reach.sayName — 상담전화는 다른 공방 사장님이 대신 받으심).
// 번호는 세 카드 모두 크게 (사용자 요청 2026-11-21: 전화번호가 더 잘 보이게)
import { Icon } from 'astro-icon/components';
import { shopFor } from '~/data/shop';
import { langFromPath, localize, useT } from '~/i18n';

export interface Props {
  /** 제목 없이 연락 카드만 (주문·문의 페이지: 위의 페이지 머리가 제목을 맡음) */
  bare?: boolean;
  /** 주문서 작성 단추를 보여 줄지 */
  showFormLink?: boolean;
}
const { bare = false, showFormLink = true } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const r = t.reach;
const shop = shopFor(lang);
---

<section class="sec-night grain relative overflow-hidden" id="reach">
  <div class:list={['relative z-[2] mx-auto max-w-7xl px-5 lg:px-8', bare ? 'py-14 md:py-20' : 'py-20 md:py-28']}>
    {
      !bare && (
        <div>
          <h2 class="display text-[clamp(2.2rem,4.6vw,3.6rem)]" data-split>
            {t.cta.title}
          </h2>
          <p class="lead mt-4 max-w-2xl">{t.cta.lead}</p>
        </div>
      )
    }

    <div class:list={['grid gap-4 lg:grid-cols-[1.35fr_1fr_1fr]', !bare && 'mt-12']} data-reveal>
      <a href={shop.consult.href} class="reach-card is-main rise group relative transition-colors hover:border-wood/50">
        <span class="flex items-center gap-2 font-bold text-wood">
          <Icon name="tabler:phone" class="h-5 w-5" aria-hidden="true" />{r.consult}
        </span>
        <span class:list={['reach-num display mt-2 leading-none tabular-nums text-paper group-hover:text-white', lang !== 'ko' && 'is-intl']}>
          {shop.consult.label}
        </span>
        <span class="mt-3 text-ivory-2">{r.consultNote}</span>
        <span class="reach-say mt-4">
          <Icon name="tabler:info-circle" class="mt-[0.2rem] h-[1.05rem] w-[1.05rem] shrink-0 text-gold-2" aria-hidden="true" />
          <span set:html={r.sayName} />
        </span>
      </a>

      <div class="reach-card rise" style="--d:0.12s">
        <span class="flex items-center gap-2 font-bold text-wood">
          <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{r.mobile}
        </span>
        <span class:list={['reach-num-2 display mt-1.5 tabular-nums text-paper', lang !== 'ko' && 'is-intl']}>{shop.mobile.label}</span>
        <span class="text-ivory-2">{r.mobileNote}</span>
        <span class="mt-4 grid grid-cols-[minmax(0,1fr)_auto] gap-2">
          <a href={shop.mobile.sms} class="btn-verm !min-h-11 !px-4 text-[0.95rem]">
            <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{r.sms}
          </a>
          <a href={shop.mobile.href} class="btn-ghost !min-h-11 !px-4 text-[0.95rem]">
            <Icon name="tabler:phone" class="h-4 w-4" aria-hidden="true" />{r.call}
          </a>
        </span>
      </div>

      <div class="reach-card rise" style="--d:0.24s">
        <!-- 세 카드의 이름표·번호 모양을 맞춤: 금색 이름표(그림 + 글) 아래 큰 번호 -->
        <span class="flex items-center gap-2 font-bold text-wood">
          <Icon name="tabler:building-store" class="h-5 w-5" aria-hidden="true" />{r.tel}
        </span>
        <a
          href={shop.tel.href}
          class:list={[
            'reach-num-2 display mt-1.5 inline-flex min-h-11 items-center self-start tabular-nums text-paper decoration-gold/50 underline-offset-4 hover:text-white hover:underline',
            lang !== 'ko' && 'is-intl',
          ]}
        >
          <!-- 번호를 한 덩어리 span으로 (inline-flex 안에 글자가 바로 있으면, 일본어·중국어 낱말 묶기 span 사이의 띄어쓰기가 사라져 '+8231-…'로 붙었음) -->
          <span>{shop.tel.label}</span>
        </a>
        <span class="mt-3 flex items-center gap-2 font-bold text-wood">
          <Icon name="tabler:printer" class="h-5 w-5" aria-hidden="true" />{r.fax}
        </span>
        <span class:list={['reach-num-2 display mt-1.5 tabular-nums text-paper', lang !== 'ko' && 'is-intl']}>{shop.fax}</span>
        <span class="text-ivory-2">{r.faxNote}</span>
      </div>
    </div>

    <p class="mt-8 flex max-w-3xl gap-3 border-l-2 border-gold pl-4 text-ivory">
      <Icon name="tabler:hand-finger" class="mt-1 h-5 w-5 shrink-0 text-wood" aria-hidden="true" />
      <span>{r.deafNote}</span>
    </p>
    {r.intlNote && <p class="mt-3 max-w-3xl text-ivory-2">{r.intlNote}</p>}
    <p class="mt-3 text-ivory-2">{shop.hours} ({shop.closed})</p>

    {
      showFormLink && (
        <a href={`${localize(lang, '/contact')}#order`} class="btn-gold mt-10">
          <Icon name="tabler:clipboard-text" class="h-5 w-5" aria-hidden="true" />
          {t.cta.form}
        </a>
      )
    }
  </div>
</section>
