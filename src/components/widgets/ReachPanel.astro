---
// 연락 방법 (홈 아래쪽, 주문·문의 페이지 위쪽). 밤 작업장 쪽빛 바탕.
// 큰 번호는 상담전화: 대표님이 소리 대신 글로 소통하셔서 전화는 상담전화가 대신 받습니다.
// 대표 휴대폰은 '문자 보내기'를 먼저 보여 줍니다(전화도 되지만 문자를 부탁).
import { Icon } from 'astro-icon/components';
import { shopFor } from '~/data/shop';
import { langFromPath, localize, useT } from '~/i18n';

export interface Props {
  /** 제목을 h1로 (주문·문의 페이지는 이 띠가 페이지 머리) */
  asPageHead?: boolean;
  /** 주문서 작성 단추를 보여 줄지 */
  showFormLink?: boolean;
}
const { asPageHead = false, showFormLink = true } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const r = t.reach;
const shop = shopFor(lang);
const Heading = asPageHead ? 'h1' : 'h2';
---

<section class="sec-night grain relative overflow-hidden" id={asPageHead ? undefined : 'reach'}>
  <div class:list={['relative z-[2] mx-auto max-w-7xl px-5 lg:px-8', asPageHead ? 'pt-10 pb-16 md:pb-24' : 'py-20 md:py-28']}>
    <slot name="top" />
    <div class="flex items-start justify-between gap-6">
      <div>
        <Heading
          class:list={['display text-paper', asPageHead ? 'text-[clamp(2.8rem,7vw,5.2rem)]' : 'text-[clamp(2.2rem,4.8vw,3.8rem)]']}
          data-split
        >
          {asPageHead ? t.contact.title : t.cta.title}
        </Heading>
        <p class="mt-4 max-w-2xl text-lg text-paper/80">{asPageHead ? t.contact.lead : t.cta.lead}</p>
      </div>
      <span class="seal hidden shrink-0 md:inline-grid" style="--seal:4.4rem" aria-hidden="true">초월</span>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-[1.35fr_1fr_1fr]" data-reveal>
      <a href={shop.consult.href} class="reach-card rise group relative transition-colors hover:border-wood/50" data-tilt>
        <span class="flex items-center gap-2 font-bold text-wood">
          <Icon name="tabler:phone" class="h-5 w-5" aria-hidden="true" />{r.consult}
        </span>
        <span class="display mt-2 text-[clamp(2.3rem,4.8vw,3.6rem)] leading-none tabular-nums text-paper group-hover:text-white">
          {shop.consult.label}
        </span>
        <span class="mt-3 text-paper/75">{r.consultNote}</span>
      </a>

      <div class="reach-card rise" style="--d:0.12s">
        <span class="flex items-center gap-2 font-bold text-wood">
          <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{r.mobile}
        </span>
        <span class="mt-1 text-2xl font-bold tabular-nums text-paper">{shop.mobile.label}</span>
        <span class="text-paper/75">{r.mobileNote}</span>
        <span class="mt-4 flex flex-wrap gap-2">
          <a href={shop.mobile.sms} class="btn-verm !min-h-11 !px-5 text-[0.95rem]">
            <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{r.sms}
          </a>
          <a href={shop.mobile.href} class="btn-ghost !min-h-11 !px-4 text-[0.95rem]">
            <Icon name="tabler:phone" class="h-4 w-4" aria-hidden="true" />{r.call}
          </a>
        </span>
      </div>

      <div class="reach-card rise" style="--d:0.24s">
        <span class="font-bold text-wood">{r.tel}</span>
        <a href={shop.tel.href} class="text-2xl font-bold tabular-nums text-paper underline-offset-4 hover:underline">
          {shop.tel.label}
        </a>
        <span class="mt-4 font-bold text-wood">{r.fax}</span>
        <span class="text-2xl font-bold tabular-nums text-paper">{shop.fax}</span>
        <span class="text-paper/75">{r.faxNote}</span>
      </div>
    </div>

    <p class="mt-8 flex max-w-3xl gap-3 border-l-2 border-verm pl-4 text-paper/90">
      <Icon name="tabler:hand-finger" class="mt-1 h-5 w-5 shrink-0 text-wood" aria-hidden="true" />
      <span>{r.deafNote}</span>
    </p>
    {r.intlNote && <p class="mt-3 max-w-3xl text-paper/70">{r.intlNote}</p>}
    <p class="mt-3 text-paper/70">{shop.hours} ({shop.closed})</p>

    {
      showFormLink && (
        <a href={`${localize(lang, '/contact')}#order`} class="btn-wood mt-10">
          <Icon name="tabler:clipboard-text" class="h-5 w-5" aria-hidden="true" />
          {t.cta.form}
        </a>
      )
    }
  </div>
</section>
