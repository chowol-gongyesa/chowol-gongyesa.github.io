---
// 휴대폰·태블릿 아래쪽에 늘 떠 있는 '상담전화 / 문자 보내기' 띠 (큰 화면에서는 숨김).
// 첫 화면을 조금 내려가면 나타나고, 글을 입력하는 동안(자판이 열릴 때)은 숨습니다.
// 문자 단추는 대표 휴대폰으로, 주문 내용 틀이 미리 채워진 채 열립니다 (src/data/shop.ts의 smsBody).
import { Icon } from 'astro-icon/components';
import { shopFor } from '~/data/shop';
import { langFromPath, useT } from '~/i18n';

const lang = langFromPath(Astro.url.pathname);
const r = useT(lang).reach;
const shop = shopFor(lang);
---

<nav class="call-bar lg:hidden" aria-label={`${r.callBar.call} · ${r.callBar.sms}`} data-call-bar>
  <a href={shop.consult.href} class="btn-gold min-h-12 justify-center gap-2 px-3 text-[1.02rem]">
    <Icon name="tabler:phone" class="h-5 w-5 shrink-0" aria-hidden="true" />{r.callBar.call}
  </a>
  <a href={shop.mobile.sms} class="btn-ghost min-h-12 justify-center gap-2 bg-black/40 px-3 text-[1.02rem]">
    <Icon name="tabler:message" class="h-5 w-5 shrink-0" aria-hidden="true" />{r.callBar.sms}
  </a>
</nav>

<script>
  let bar: HTMLElement | null = null;
  let typing = false;
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!bar) return;
    const show = window.scrollY > window.innerHeight * 0.55 && !typing;
    bar.classList.toggle('is-on', show);
  };
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  // 입력칸에 글을 쓰는 동안은 띠를 숨겨 자판·입력칸을 가리지 않게
  document.addEventListener('focusin', (e) => {
    const el = e.target as HTMLElement;
    typing = !!el.closest?.('input, textarea, select');
    update();
  });
  document.addEventListener('focusout', () => {
    typing = false;
    setTimeout(update, 150);
  });
  document.addEventListener('astro:page-load', () => {
    bar = document.querySelector<HTMLElement>('[data-call-bar]');
    update();
  });
</script>
