---
import { SITE } from 'astrowind:config';

// 검색 사이트 소유 확인 코드.
// 네이버 서치어드바이저: 초월공예 사이트를 등록한 뒤 받은 코드를 아래에 넣으세요 (지금은 없음).
//   ⚠️ 예전에 여기 있던 코드는 성창공예 사이트의 것이라 지웠습니다(2026-11-21) — 다른 사이트 코드를 넣으면 그 사이트 소유로 잡힙니다.
// 구글 코드는 src/config.yaml 의 googleSiteVerificationId 에 넣습니다.
const NAVER_SITE_VERIFICATION: string | null = null;
---

{SITE.googleSiteVerificationId && <meta name="google-site-verification" content={SITE.googleSiteVerificationId} />}
{NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
