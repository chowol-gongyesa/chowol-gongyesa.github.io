---
// 맨 위의 금색 선: 스크롤한 만큼 늘어나는 진행 표시줄.
// (예전에는 페이지를 옮길 때 세로 띠가 내려와 덮었다가 걷혔지만, 휴대폰에서 화면이 들썩여 보여서 없앴습니다.
//  지금은 페이지가 짧게 겹쳐 바뀌기만 함 → tailwind.css의 ::view-transition)
---

<div id="progress" transition:persist aria-hidden="true"></div>

<script>
  let ticking = false;
  const update = () => {
    ticking = false;
    const bar = document.getElementById('progress');
    if (!bar) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true }
  );
  window.addEventListener('resize', update);
  document.addEventListener('astro:page-load', update);
</script>
