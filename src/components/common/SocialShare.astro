---
// 공유 버튼. 휴대폰에서는 '공유하기'를 누르면 카카오톡·문자 등 휴대폰 공유 창이 열리고,
// 공유 창이 없는 컴퓨터에서는 주소를 복사합니다. url을 안 주면 지금 보고 있는 페이지 주소를 씁니다.
import { Icon } from 'astro-icon/components';
import { langFromPath, useT } from '~/i18n';

export interface Props {
  text?: string;
  url?: string | URL;
  class?: string;
  /** 파란 바탕(바닥글) 위에서 쓸 때: 흰 테 단추 */
  onSign?: boolean;
}

const t = useT(langFromPath(Astro.url.pathname)).share;
// url을 안 주면 브라우저에 떠 있는 주소를 그대로 공유 (설정의 사이트 주소가 아직 임시라도 맞는 주소가 나감)
const { text = '', url, class: className = 'inline-block', onSign = false } = Astro.props;
const btn = onSign
  ? 'inline-flex min-h-11 items-center gap-2 rounded-full border border-gold/50 px-4 text-[0.95rem] font-bold text-ivory hover:border-gold-2 hover:bg-gold/10'
  : 'inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-verm px-4 text-[0.95rem] font-bold text-verm hover:bg-verm hover:text-white';
---

<aw-social-share
  class={className}
  data-aw-url={url ? String(url) : undefined}
  data-aw-text={text}
  data-label-copy={t.copy}
  data-label-copied={t.copied}
  data-label-prompt={t.prompt}
>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-aw-share
      class={btn}
    >
      <Icon name="tabler:share" class="h-5 w-5" />{t.share}
    </button>
    <button
      type="button"
      data-aw-copy
      class={btn}
    >
      <Icon name="tabler:link" class="h-5 w-5" /><span data-aw-copy-label aria-live="polite">{t.copy}</span
      >
    </button>
  </div>
</aw-social-share>

<script>
  class AwSocialShare extends HTMLElement {
    connectedCallback() {
      // 주소·제목은 누를 때 읽음 (사이트 안에서 페이지를 옮기면 바닥글이 새 주소로 바뀌기 전에 만들어질 수 있어서 — 예전엔 앞 페이지 주소가 공유됐음)
      const getUrl = () => this.dataset.awUrl || location.href.split('#')[0];
      const getText = () => this.dataset.awText || document.title;
      const label = this.querySelector<HTMLElement>('[data-aw-copy-label]');
      const { labelCopy = '', labelCopied = '', labelPrompt = '' } = this.dataset;

      const copy = async () => {
        const url = getUrl();
        try {
          await navigator.clipboard.writeText(url);
          if (label) label.textContent = labelCopied;
        } catch {
          window.prompt(labelPrompt, url);
          return;
        }
        setTimeout(() => label && (label.textContent = labelCopy), 2000);
      };

      this.querySelector('[data-aw-copy]')?.addEventListener('click', copy);
      this.querySelector('[data-aw-share]')?.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title: getText(), url: getUrl() });
          } catch {
            /* 사용자가 공유 창을 닫음 */
          }
        } else {
          copy();
        }
      });
    }
  }

  if (!customElements.get('aw-social-share')) {
    customElements.define('aw-social-share', AwSocialShare);
  }
</script>
