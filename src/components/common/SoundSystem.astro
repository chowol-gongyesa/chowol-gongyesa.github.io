---
// 소리: 배경 음악(반복), 입장음, 단추 소리(나무 '똑'), 페이지 넘김 소리, 소리 켜기 소리. 파일은 public/sound/ (모두 합성해 만든 것)
// - 소리는 처음부터 '켜짐'이 기본입니다(사용자 요청 2026-11-21). 상단 메뉴(Header.astro)·입장 화면의 소리 단추로 끄면
//   그 선택을 이 브라우저에 기억합니다(localStorage 'cw-sound' = 'on' | 'off').
// - 브라우저는 사람이 화면을 한 번 누르기 전에는 소리를 못 내게 막습니다. 그래서 켜짐이어도 처음엔 조용할 수 있고,
//   화면을 처음 누르는(클릭·탭) 순간 배경 음악을 (소리 0에서) 시작해 천천히 키웁니다.
//   막혀서 아직 안 들리는 동안 소리 단추는 '기다림'(data-state="wait": 꺼진 그림 + 반짝임)으로 보여 주고, 누르면 바로 소리가 납니다.
//   음량은 Web Audio로 조절합니다(아이폰은 audio.volume을 무시하기 때문).
// - 작업 영상의 소리가 나는 동안 배경 음악은 0으로 줄였다가, 영상 소리가 꺼지면 다시 키웁니다.
// - 켜고 끌 때마다 window에 'cw:sound' 알림({ on })을 보냅니다 (작업 영상이 따라 소리를 끄고 켬).
// 다른 부품에서 쓰기: window.cwSound.play('click'), window.cwSound.set(true|false), window.cwSound.enter(withSound), window.cwSound.get()
import { getAsset } from '~/utils/permalinks';
---

<audio id="cw-bgm" src={getAsset("/sound/bgm.mp3")} loop preload="none" transition:persist></audio>

<script>
  type Name = 'intro' | 'click' | 'page' | 'sound-on';
  const KEY = 'cw-sound';
  const BGM_VOL = 0.32;
  const read = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  const write = (v: string) => {
    try {
      localStorage.setItem(KEY, v);
    } catch {
      /* storage unavailable */
    }
  };

  let ctx: AudioContext | null = null;
  let bgmGain: GainNode | null = null;
  let bgmNode: MediaElementAudioSourceNode | null = null;
  const buffers = new Map<Name, AudioBuffer>();
  let loading: Promise<void> | null = null;
  let on = read() !== 'off'; // 기본은 켜짐 — 사용자가 끈 적이 있을 때만 꺼짐
  let ducked = false;
  let pauseTimer = 0;

  const bgm = () => document.getElementById('cw-bgm') as HTMLAudioElement | null;

  const ensureCtx = () => {
    if (!ctx) {
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (!AC) return null;
      ctx = new AC();
      ctx.addEventListener('statechange', syncButtons);
    }
    if (ctx.state !== 'running') ctx.resume().catch(() => {});
    return ctx;
  };
  // 배경 음악을 Web Audio 음량 조절기(GainNode)에 한 번만 연결
  const ensureBgm = () => {
    const a = bgm();
    const c = ensureCtx();
    if (!a || !c) return null;
    if (!a.dataset.watched) {
      a.dataset.watched = '1';
      a.addEventListener('playing', syncButtons);
      a.addEventListener('pause', syncButtons);
    }
    if (!bgmNode) {
      try {
        bgmNode = c.createMediaElementSource(a);
        bgmGain = c.createGain();
        bgmGain.gain.value = 0;
        bgmNode.connect(bgmGain).connect(c.destination);
      } catch {
        bgmNode = null;
        bgmGain = null;
      }
    }
    return a;
  };
  // 음량을 target까지 (delay초 뒤부터 seconds초 동안) 부드럽게
  const ramp = (target: number, seconds: number, delay = 0) => {
    const a = bgm();
    if (!ctx || !a) return;
    if (!bgmGain) {
      a.volume = target; // Web Audio를 못 쓰는 브라우저
      return;
    }
    const g = bgmGain.gain;
    const now = ctx.currentTime;
    g.cancelScheduledValues(now);
    g.setValueAtTime(g.value, now);
    if (delay) g.setValueAtTime(g.value, now + delay);
    g.linearRampToValueAtTime(target, now + delay + seconds);
  };
  const load = () => {
    if (loading) return loading;
    const c = ensureCtx();
    if (!c) return Promise.resolve();
    loading = Promise.all(
      (['intro', 'click', 'page', 'sound-on'] as Name[]).map((name) =>
        fetch(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sound/${name}.mp3`)
          .then((r) => r.arrayBuffer())
          .then((data) => c.decodeAudioData(data))
          .then((buf) => {
            buffers.set(name, buf);
          })
          .catch(() => {})
      )
    ).then(() => {});
    return loading;
  };
  const play = (name: Name, gain = 1) => {
    if (!on || !ctx || ctx.state !== 'running') return;
    const buf = buffers.get(name);
    if (!buf) {
      load();
      return;
    }
    const src = ctx.createBufferSource();
    const g = ctx.createGain();
    g.gain.value = gain;
    src.buffer = buf;
    src.connect(g).connect(ctx.destination);
    src.start();
  };

  // 배경 음악 시작 — 반드시 누르기(click/touchend/keydown) 처리 안에서 불러야 휴대폰에서도 소리가 남
  const startBgm = (delay = 0, fade = 2.5) => {
    if (!on) return;
    const a = ensureBgm();
    if (!a) return;
    window.clearTimeout(pauseTimer);
    if (a.paused) {
      if (bgmGain && ctx) bgmGain.gain.setValueAtTime(0, ctx.currentTime);
      a.play().catch(() => {});
    }
    ramp(ducked ? 0 : BGM_VOL, fade, delay);
  };
  const stopBgm = (seconds = 0.5) => {
    ramp(0, seconds);
    window.clearTimeout(pauseTimer);
    pauseTimer = window.setTimeout(() => {
      if (!on) bgm()?.pause();
    }, seconds * 1000 + 120);
  };

  // 지금 배경 음악이 실제로 들리는(재생 중인) 상태인지 — 켜짐이어도 브라우저가 막으면 아직 아님
  const audible = () => {
    const a = bgm();
    return on && !!a && !a.paused && (!ctx || ctx.state === 'running');
  };
  // 소리 단추 모양: on(들림) · wait(켜짐이지만 화면을 누르기 전이라 아직 조용함) · off(꺼짐)
  // 이름은 들리면 '끄기', 아니면 '켜기'로 바뀌므로 aria-pressed는 쓰지 않음
  function syncButtons() {
    const state = !on ? 'off' : audible() ? 'on' : 'wait';
    document.querySelectorAll<HTMLButtonElement>('.sound-toggle').forEach((btn) => {
      btn.dataset.state = state;
      const label = state === 'on' ? btn.dataset.labelOff! : btn.dataset.labelOn!;
      btn.setAttribute('aria-label', label);
      btn.title = label;
    });
  }
  const tell = () => window.dispatchEvent(new CustomEvent('cw:sound', { detail: { on } }));
  const set = (value: boolean, chime = true) => {
    on = value;
    write(on ? 'on' : 'off');
    syncButtons();
    tell();
    if (on) {
      startBgm(chime ? 0.3 : 0, 1.6);
      load().then(() => {
        if (chime) play('sound-on', 0.6);
      });
    } else stopBgm();
  };
  // 입장 화면에서 '입장하기' (누르는 순간 불림)
  const enter = (withSound: boolean) => {
    on = withSound;
    write(on ? 'on' : 'off');
    syncButtons();
    tell();
    if (!on) return;
    startBgm(2.4, 2.6);
    load().then(() => play('intro', 0.9));
  };

  (window as unknown as { cwSound: object }).cwSound = { play, set, enter, get: () => on };

  // 소리를 켜 둔 채 새로 고침한 경우 등: 다음에 누를 때 배경 음악을 이어서 (될 때까지 매번 시도)
  const resume = (e: Event) => {
    if (!on) return;
    // 소리 단추·입장 화면은 따로 처리, 전화·문자 링크와 주문서 '문자로 보내기'(문자 앱이 열림)를 누를 때는 음악을 시작하지 않음
    if ((e.target as HTMLElement | null)?.closest?.('.sound-toggle, #intro, a[href^="tel:"], a[href^="sms:"], #order-form button[type="submit"]')) return;
    const a = bgm();
    if (ctx && ctx.state === 'running' && a && !a.paused) return;
    load();
    startBgm(0, 1.5);
  };
  // 키보드(Tab·주문서 글자 입력)로는 시작하지 않음 — 화면 읽기 프로그램·입력과 겹치지 않게. Enter로 단추·링크를 누르면 click이라 시작됨
  ['click', 'touchend'].forEach((type) => document.addEventListener(type, resume, { capture: true, passive: true }));

  // 단추·링크를 누르면 나무 '똑'
  document.addEventListener('pointerdown', (e) => {
    if (!on || e.button !== 0) return;
    const t = e.target as HTMLElement;
    if (t.closest('#intro, .sound-toggle, input, textarea, select')) return;
    if (t.closest('a, button, summary, [role="button"]')) play('click', 0.55);
  });
  // 페이지를 옮길 때
  document.addEventListener('astro:before-preparation', () => play('page', 0.7));
  // 작업 영상 소리가 켜지면 배경 음악을 0으로, 꺼지면 다시
  window.addEventListener('cw:film-sound', (e) => {
    ducked = !!(e as CustomEvent<{ on: boolean }>).detail?.on;
    if (on) ramp(ducked ? 0 : BGM_VOL, ducked ? 0.6 : 1.6);
  });
  // 다른 탭·전화 앱·문자 앱으로 가면 쉬고, 돌아오면 (그 전에 실제로 흐르고 있었을 때만) 음량 조절기를 거쳐 다시 천천히
  // (예전 오류: 한 번도 시작 안 한 음악이 돌아올 때 음량 조절 없이 크게 나왔음 — 전화·문자를 누르고 돌아온 경우)
  let wasPlaying = false;
  document.addEventListener('visibilitychange', () => {
    const a = bgm();
    if (!a) return;
    if (document.hidden) {
      wasPlaying = !a.paused;
      if (wasPlaying) a.pause();
    } else if (on && wasPlaying) {
      wasPlaying = false;
      startBgm(0, 0.8);
    }
  });
  // 상단 메뉴의 소리 단추
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>('.sound-toggle:not([data-bound])').forEach((btn) => {
      btn.dataset.bound = '';
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        // 켜짐인데 브라우저가 막아 아직 안 들리던 상태면, 끄지 않고 지금 소리를 냄 (이 누르기로 소리가 허락됨)
        if (on && !audible()) set(true);
        else set(!on);
      });
    });
    syncButtons();
  };
  document.addEventListener('astro:page-load', bind);
</script>
