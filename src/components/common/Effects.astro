---
// 공방 연출 모음 (모든 페이지)
// 1) 마우스 효과: 움직인 자리에 고운 백목 가루가 흩날리다 가라앉음 (마우스가 있는 컴퓨터만)
// 2) 단추·링크·카드를 누르면 그 자리에서 얇게 말린 대팻밥이 튐
// 3) data-split 제목은 화면에 들어올 때 글자가 하나씩 떠오름
// 4) data-tilt 카드는 마우스를 따라 살짝 기울고 빛이 비침
// 5) data-reveal 칸이 화면에 들어오면 .is-in → 사진이 대패질하듯 걷히고(.wipe) 글이 떠오름(.rise)
// 움직임 줄이기 설정이면 1·2·4는 꺼지고 3·5는 바로 다 보입니다.
---

<canvas id="cursor-dust" transition:persist aria-hidden="true"></canvas>
<div id="craft-fx" transition:persist aria-hidden="true"></div>

<script>
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  // ---------- 1) 나무 가루 ----------
  type Speck = { x: number; y: number; vx: number; vy: number; life: number; max: number; size: number; tone: number; rot: number };
  const specks: Speck[] = [];
  let running = false;
  let lastX = -1;
  let lastY = -1;
  let ctx: CanvasRenderingContext2D | null = null;
  const resize = () => {
    const c = document.getElementById('cursor-dust') as HTMLCanvasElement | null;
    if (!c) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    c.width = innerWidth * dpr;
    c.height = innerHeight * dpr;
    ctx = c.getContext('2d');
    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  window.addEventListener('resize', resize);
  const TONES = ['#f1e2c6', '#e6cfa6', '#d9b98a', '#c9a271'];
  const frame = () => {
    if (!ctx) resize();
    if (!ctx) return;
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    for (let i = specks.length - 1; i >= 0; i--) {
      const s = specks[i];
      s.life++;
      s.vy += 0.045;
      s.vx *= 0.96;
      s.x += s.vx;
      s.y += s.vy;
      s.rot += s.vx * 0.08;
      const t = s.life / s.max;
      if (t >= 1) {
        specks.splice(i, 1);
        continue;
      }
      ctx.globalAlpha = (1 - t) * 0.9;
      ctx.fillStyle = TONES[s.tone];
      ctx.save();
      ctx.translate(s.x, s.y);
      ctx.rotate(s.rot);
      ctx.fillRect(-s.size, -s.size * 0.45, s.size * 2, s.size * 0.9);
      ctx.restore();
    }
    ctx.globalAlpha = 1;
    if (specks.length) requestAnimationFrame(frame);
    else running = false;
  };
  document.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || !fine() || reduce()) return;
    const dx = e.clientX - lastX;
    const dy = e.clientY - lastY;
    const dist = Math.hypot(dx, dy);
    lastX = e.clientX;
    lastY = e.clientY;
    if (dist < 5 || dist > 300) return;
    const count = Math.min(3, 1 + Math.floor(dist / 16));
    for (let i = 0; i < count && specks.length < 110; i++) {
      specks.push({
        x: e.clientX + (Math.random() - 0.5) * 6,
        y: e.clientY + (Math.random() - 0.5) * 6,
        vx: (Math.random() - 0.5) * 0.9 - dx * 0.02,
        vy: (Math.random() - 0.5) * 0.6 - 0.4,
        life: 0,
        max: 36 + Math.random() * 30,
        size: 0.9 + Math.random() * 1.6,
        tone: Math.floor(Math.random() * TONES.length),
        rot: Math.random() * 3,
      });
    }
    if (!running) {
      running = true;
      requestAnimationFrame(frame);
    }
  });

  // ---------- 2) 대팻밥 ----------
  const SHAVE_COLORS = ['#f1e2c6', '#e6cfa6', '#d9b98a', '#c9a271', '#b8895a'];
  const SHAPES = ['M2 10c3-7 11-9 15-3s-1 11-6 8', 'M2 8c4-6 12-6 14 0s-6 8-9 4', 'M3 12c2-8 13-10 15-2', 'M2 6c6 0 10 4 9 9'];
  const burst = (x: number, y: number) => {
    const layer = document.getElementById('craft-fx');
    if (!layer) return;
    const count = 8 + Math.floor(Math.random() * 4);
    for (let i = 0; i < count; i++) {
      const el = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      el.setAttribute('viewBox', '0 0 20 20');
      el.setAttribute('class', 'shaving');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', SHAPES[i % SHAPES.length]);
      path.setAttribute('stroke', SHAVE_COLORS[Math.floor(Math.random() * SHAVE_COLORS.length)]);
      el.appendChild(path);
      const size = 11 + Math.random() * 13;
      el.style.cssText = `left:${x - size / 2}px;top:${y - size / 2}px;width:${size}px;height:${size}px`;
      layer.appendChild(el);
      const angle = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.4;
      const dist = 40 + Math.random() * 80;
      const ddx = Math.cos(angle) * dist;
      const ddy = Math.sin(angle) * dist;
      const spin = (Math.random() < 0.5 ? -1 : 1) * (200 + Math.random() * 360);
      el.animate(
        [
          { transform: 'translate(0,0) rotate(0deg) scale(0.4)', opacity: 1 },
          { transform: `translate(${ddx}px,${ddy}px) rotate(${spin * 0.6}deg) scale(1)`, opacity: 1, offset: 0.35 },
          { transform: `translate(${ddx * 1.3}px,${ddy + 100}px) rotate(${spin}deg) scale(0.9)`, opacity: 0 },
        ],
        { duration: 950 + Math.random() * 500, easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)' }
      ).onfinish = () => el.remove();
    }
  };
  document.addEventListener('pointerdown', (e) => {
    if (e.button !== 0 || reduce()) return;
    const target = e.target as HTMLElement;
    if (target.closest('input, textarea, select, [contenteditable], dialog, #intro')) return;
    if (!target.closest('a, button, summary, [data-tilt]')) return;
    burst(e.clientX, e.clientY);
  });

  // ---------- 3) 글자가 하나씩 떠오르는 제목 ----------
  const splitHeadings = () => {
    const cjk = /^(ja|zh)/.test(document.documentElement.lang);
    document.querySelectorAll<HTMLElement>('[data-split]:not([data-split-done])').forEach((el) => {
      el.dataset.splitDone = '';
      if (reduce()) return;
      const text = el.textContent?.trim() ?? '';
      if (!text) return;
      el.setAttribute('aria-label', text);
      let i = 0;
      const pieces = cjk ? Array.from(text) : text.split(/([ \t\n]+)/);
      el.innerHTML = '';
      pieces.forEach((piece) => {
        if (/^[ \t\n]+$/.test(piece)) {
          el.appendChild(document.createTextNode(' '));
          return;
        }
        const word = document.createElement('span');
        word.className = 'split-word';
        word.setAttribute('aria-hidden', 'true');
        Array.from(piece).forEach((ch) => {
          const span = document.createElement('span');
          span.className = 'split-char';
          span.style.setProperty('--i', String(i++));
          span.textContent = ch;
          word.appendChild(span);
        });
        el.appendChild(word);
      });
      el.classList.add('split-ready');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            io.disconnect();
            requestAnimationFrame(() => el.classList.add('split-in'));
          }),
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  };

  // ---------- 4) 기울어지는 카드 ----------
  const tilt = () => {
    if (!fine() || reduce()) return;
    document.querySelectorAll<HTMLElement>('[data-tilt]:not([data-tilt-ready])').forEach((card) => {
      card.dataset.tiltReady = '';
      let raf = 0;
      card.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.style.transform = `perspective(900px) rotateX(${(0.5 - py) * 6}deg) rotateY(${(px - 0.5) * 7}deg) translateY(-2px)`;
          card.style.setProperty('--gx', `${px * 100}%`);
          card.style.setProperty('--gy', `${py * 100}%`);
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        card.style.transform = '';
      });
    });
  };

  // ---------- 5) 화면에 들어오면 드러나기 ----------
  const reveal = () => {
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
    if (reduce() || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-in'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }),
      { threshold: 0.18, rootMargin: '0px 0px -6% 0px' }
    );
    items.forEach((el) => io.observe(el));
  };

  document.addEventListener('astro:page-load', () => {
    resize();
    splitHeadings();
    tilt();
    reveal();
  });
</script>
