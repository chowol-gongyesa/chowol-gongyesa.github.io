---
// 공방 연출 모음 (모든 페이지)
// 1) 금빛 커서: 작은 점은 바로, 고리는 천천히 따라옴. 링크 위에선 고리가 커지고, 사진·영상(data-cursor) 위에선 '보기'·'재생' 글자
// 2) 등잔불: 마우스 주변을 따뜻하게 비춤 + 움직인 자리에 금빛 나무 가루
// 3) 누르면 나이테처럼 금빛 고리가 퍼짐 (성창공예의 톱밥과 다르게)
// 4) data-split 제목은 화면에 들어올 때 글자가 하나씩 떠오름
// 5) data-tilt 카드는 마우스를 따라 살짝 기울고 빛이 비침
// 6) data-reveal 칸이 화면에 들어오면 .is-in → 사진이 걷히고(.wipe) 글이 떠오름(.rise)
// 마우스가 없는 휴대폰·태블릿에서는 1·2가 꺼지고, 움직임 줄이기 설정이면 2·3·5가 꺼집니다.
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useT(lang).cursor;
---

<div id="cw-lantern" transition:persist aria-hidden="true"></div>
<canvas id="cursor-dust" transition:persist aria-hidden="true"></canvas>
<div id="craft-fx" transition:persist aria-hidden="true"></div>
<div id="cw-ring" transition:persist aria-hidden="true" data-view={c.view} data-play={c.play}><span></span></div>
<div id="cw-dot" transition:persist aria-hidden="true"></div>

<script>
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  // ---------- 1) 금빛 커서 + 2) 등잔불·나무 가루 ----------
  let mx = -100;
  let my = -100;
  let rx = -100;
  let ry = -100;
  let started = false;
  type Speck = { x: number; y: number; vx: number; vy: number; life: number; max: number; size: number };
  const specks: Speck[] = [];
  let ctx: CanvasRenderingContext2D | null = null;
  const resize = () => {
    const cv = document.getElementById('cursor-dust') as HTMLCanvasElement | null;
    if (!cv) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    cv.width = innerWidth * dpr;
    cv.height = innerHeight * dpr;
    ctx = cv.getContext('2d');
    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  window.addEventListener('resize', resize);

  const tick = () => {
    const dot = document.getElementById('cw-dot');
    const ring = document.getElementById('cw-ring');
    rx += (mx - rx) * 0.18;
    ry += (my - ry) * 0.18;
    if (dot) dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
    if (ring) ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
    // 나무 가루
    if (!ctx) resize();
    if (ctx) {
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      ctx.globalCompositeOperation = 'lighter';
      for (let i = specks.length - 1; i >= 0; i--) {
        const s = specks[i];
        s.life++;
        s.vy += 0.02;
        s.vx *= 0.97;
        s.x += s.vx;
        s.y += s.vy;
        const t = s.life / s.max;
        if (t >= 1) {
          specks.splice(i, 1);
          continue;
        }
        const a = (1 - t) * 0.85;
        ctx.fillStyle = `rgba(240, 205, 140, ${a})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size * (1 - t * 0.5), 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(255, 220, 160, ${a * 0.18})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size * 3.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalCompositeOperation = 'source-over';
    }
    requestAnimationFrame(tick);
  };

  let lastX = -1;
  let lastY = -1;
  document.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || !fine()) return;
    mx = e.clientX;
    my = e.clientY;
    if (!started) {
      started = true;
      rx = mx;
      ry = my;
      document.documentElement.classList.add('has-cursor');
      requestAnimationFrame(tick);
    }
    const lantern = document.getElementById('cw-lantern');
    lantern?.style.setProperty('--lx', `${mx}px`);
    lantern?.style.setProperty('--ly', `${my}px`);
    if (reduce()) return;
    const dist = Math.hypot(mx - lastX, my - lastY);
    if (dist > 6 && dist < 300 && specks.length < 30) {
      const n = Math.min(2, 1 + Math.floor(dist / 30));
      for (let i = 0; i < n; i++) {
        specks.push({
          x: mx + (Math.random() - 0.5) * 8,
          y: my + (Math.random() - 0.5) * 8,
          vx: (Math.random() - 0.5) * 0.7,
          vy: -0.2 - Math.random() * 0.5,
          life: 0,
          max: 40 + Math.random() * 30,
          size: 0.8 + Math.random() * 1.4,
        });
      }
    }
    lastX = mx;
    lastY = my;
  });
  document.addEventListener('pointerleave', () => document.documentElement.classList.remove('has-cursor'));
  document.addEventListener('pointerenter', (e) => {
    if ((e as PointerEvent).pointerType === 'mouse' && started) document.documentElement.classList.add('has-cursor');
  });
  // 커서가 무엇 위에 있는지
  document.addEventListener('pointerover', (e) => {
    const ring = document.getElementById('cw-ring');
    if (!ring) return;
    const target = e.target as HTMLElement;
    const media = target.closest<HTMLElement>('[data-cursor]');
    const link = target.closest('a, button, summary, label, [role="button"], input[type="range"]');
    ring.classList.toggle('is-media', !!media);
    ring.classList.toggle('is-link', !media && !!link);
    const label = ring.querySelector('span');
    if (label) label.textContent = media ? (media.dataset.cursor === 'play' ? ring.dataset.play : ring.dataset.view) ?? '' : '';
  });
  document.addEventListener('pointerdown', () => document.getElementById('cw-ring')?.classList.add('is-down'));
  document.addEventListener('pointerup', () => document.getElementById('cw-ring')?.classList.remove('is-down'));

  // ---------- 3) 나이테 고리 ----------
  document.addEventListener('pointerdown', (e) => {
    if (e.button !== 0 || reduce()) return;
    const target = e.target as HTMLElement;
    if (target.closest('input, textarea, select, [contenteditable], dialog')) return;
    if (!target.closest('a, button, summary, [data-tilt], [data-cursor], #intro')) return;
    const layer = document.getElementById('craft-fx');
    if (!layer) return;
    [0, 0.08, 0.16].forEach((delay, i) => {
      const ring = document.createElement('i');
      ring.className = 'ring';
      const size = 46 + i * 34;
      ring.style.cssText = `left:${e.clientX}px;top:${e.clientY}px;width:${size}px;height:${size}px;--delay:${delay}s`;
      layer.appendChild(ring);
      window.setTimeout(() => ring.remove(), 1200);
    });
  });

  // ---------- 4) 글자가 하나씩 떠오르는 제목 ----------
  const splitHeadings = () => {
    const cjk = /^(ja|zh)/.test(document.documentElement.lang);
    document.querySelectorAll<HTMLElement>('[data-split]:not([data-split-done])').forEach((el) => {
      el.dataset.splitDone = '';
      if (reduce()) return;
      const text = el.textContent?.trim() ?? '';
      if (!text) return;
      el.setAttribute('aria-label', text);
      let i = 0;
      const pieces = cjk ? Array.from(text) : text.split(/([ \t\n]+)/);
      el.innerHTML = '';
      pieces.forEach((piece) => {
        if (/^[ \t\n]+$/.test(piece)) {
          el.appendChild(document.createTextNode(' '));
          return;
        }
        const word = document.createElement('span');
        word.className = 'split-word';
        word.setAttribute('aria-hidden', 'true');
        Array.from(piece).forEach((ch) => {
          const span = document.createElement('span');
          span.className = 'split-char';
          span.style.setProperty('--i', String(i++));
          span.textContent = ch;
          word.appendChild(span);
        });
        el.appendChild(word);
      });
      el.classList.add('split-ready');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            io.disconnect();
            el.classList.add('split-in');
          }),
        { threshold: 0, rootMargin: '0px 0px -8% 0px' }
      );
      io.observe(el);
    });
  };

  // ---------- 5) 기울어지는 카드 ----------
  const tilt = () => {
    if (!fine() || reduce()) return;
    document.querySelectorAll<HTMLElement>('[data-tilt]:not([data-tilt-ready])').forEach((card) => {
      card.dataset.tiltReady = '';
      let raf = 0;
      card.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.style.transform = `perspective(900px) rotateX(${(0.5 - py) * 5}deg) rotateY(${(px - 0.5) * 6}deg) translateY(-2px)`;
          card.style.setProperty('--gx', `${px * 100}%`);
          card.style.setProperty('--gy', `${py * 100}%`);
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        card.style.transform = '';
      });
    });
  };

  // ---------- 6) 화면에 들어오면 드러나기 (키가 큰 칸도 위쪽이 보이면 바로) ----------
  const reveal = () => {
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
    if (reduce() || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-in'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }),
      { threshold: 0, rootMargin: '0px 0px -8% 0px' }
    );
    items.forEach((el) => io.observe(el));
  };

  document.addEventListener('astro:page-load', () => {
    resize();
    splitHeadings();
    tilt();
    reveal();
  });
</script>
