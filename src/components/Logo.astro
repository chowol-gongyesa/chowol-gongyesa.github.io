---
// 로고: 나이테 원판 + 나무로 깎은 글자 '초월공예사' 그림 (public/brand/logo-h.webp, 만드는 법 scripts/make_logo.py)
// + 금테 '로구로 전문'. 글자 위로 빛이 주기적으로 스침(.logo-shine: 글자 모양으로만 보이게 mask).
// 외국어 페이지에서도 상호는 한글 그대로 두고, 띠의 글자만 그 나라 말로 바꿉니다.
import { SHOP } from '~/data/shop';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang?: Lang;
  size?: 'md' | 'lg';
}
const { lang = 'ko', size = 'md' } = Astro.props;
const t = useT(lang);
---

<span class="inline-flex items-center gap-3 whitespace-nowrap">
  <span class:list={['logo-art relative block', size === 'lg' ? 'h-[3.2rem]' : 'h-[2.1rem] md:h-[2.5rem]']}>
    <img src="/brand/logo-h.webp" alt={SHOP.name} width="1645" height="306" class="block h-full w-auto" decoding="async" />
    <span class="logo-shine" aria-hidden="true"></span>
  </span>
  <span class:list={['logo-pill pill', size === 'lg' ? 'text-[0.95rem]' : 'text-[0.85rem] md:text-[0.9rem]']}>{t.pill}</span>
</span>
