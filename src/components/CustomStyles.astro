---
// 색·글꼴 (3차 '먹감나무 공방'): 그을린 호두나무처럼 짙은 나무 바탕 + 금박 + 상아색 글씨, 낙관만 주홍.
// 글꼴: 제목 나눔명조(굵게), 본문은 기기의 한글 고딕(애플 산돌고딕·맑은 고딕·Noto Sans CJK), 상호는 나무 글자 그림(public/brand/, scripts/make_logo.py).
//
// ⚠️ 2차 디자인의 이름을 그대로 쓰는 부품이 있어 옛 이름을 새 색에 연결해 두었습니다:
//    ink(글씨) → 상아색, ink-soft → 옅은 상아색, paper → 상아색, verm(강조) → 금색, wood → 밝은 금색, night → 짙은 바탕
---

<style is:inline>
  :root {
    --bg: #120d09;
    --bg-2: #1a130d;
    --bg-3: #241a12;
    --ivory: #f3e9d8;
    --ivory-2: #d8cab1;
    --ivory-3: #b4a68e;
    --gold: #cda763;
    --gold-2: #e8c98c;
    --gold-3: #8e6b34;
    --seal: #b33b2b;
    --line: rgb(205 167 99 / 0.22);

    /* 옛 이름 (2차 디자인 부품용) */
    --night: var(--bg);
    --night-2: var(--bg-2);
    --paper: var(--ivory);
    --paper-2: var(--bg-3);
    --wood: var(--gold-2);
    --wood-deep: var(--gold);
    --walnut: #6d4c2c;
    --ink: var(--ivory);
    --ink-soft: var(--ivory-2);
    --verm: var(--gold);

    /* 본문은 기기에 있는 한글 글꼴 (내려받을 글꼴을 줄여 휴대폰에서 빨리 뜨게) */
    --aw-font-sans: 'Noto Sans KR', 'Noto Sans CJK KR', 'Apple SD Gothic Neo', 'Malgun Gothic', system-ui, sans-serif;
    --aw-font-serif: 'Nanum Myeongjo', serif;
    --aw-font-heading: 'Nanum Myeongjo', 'AppleMyungjo', serif;
    --brand-font: 'Nanum Myeongjo', serif; /* 상호는 그림으로 바뀌어 거의 쓰지 않음 */

    --aw-color-primary: rgb(205 167 99);
    --aw-color-secondary: rgb(232 201 140);
    --aw-color-accent: rgb(179 59 43);
    --aw-color-link: rgb(232 201 140);
    --aw-color-text-heading: rgb(243 233 216);
    --aw-color-text-default: rgb(243 233 216);
    --aw-color-text-muted: rgb(216 202 177);
    --aw-color-bg-page: rgb(18 13 9);
    --aw-color-bg-page-dark: rgb(18 13 9);

    ::selection {
      background-color: #cda763;
      color: #120d09;
    }
  }

  /* 일본어·중국어 페이지 글꼴 (이 :root 규칙 뒤에 있어야 적용됨) */
  :root:lang(ja) {
    --aw-font-sans: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Meiryo', 'Noto Sans CJK JP', system-ui, sans-serif;
    --aw-font-heading: 'Shippori Mincho B1', 'Hiragino Mincho ProN', serif;
  }
  :root:lang(zh) {
    --aw-font-sans: 'PingFang SC', 'Microsoft YaHei', 'Noto Sans CJK SC', system-ui, sans-serif;
    --aw-font-heading: 'Noto Serif SC', 'Songti SC', serif;
  }

  :root:lang(ko) body {
    word-break: keep-all;
  }
</style>
