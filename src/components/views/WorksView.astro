---
// 작업물 페이지. 한국어(/works)와 다른 언어 페이지가 함께 씁니다.
import Layout from '~/layouts/PageLayout.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import { CATEGORY_KEYS, GALLERY_COUNT, WORKS_COUNT, galleryBy } from '~/data/works';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const w = t.worksPage;

const metadata = {
  title: w.metaTitle,
  description: w.metaDescription(GALLERY_COUNT),
};
---

<Layout metadata={metadata} lang={lang}>
  <PageHead
    lang={lang}
    title={w.title}
    lead={w.lead(GALLERY_COUNT, WORKS_COUNT)}
    crumb={t.nav.works}
    image="~/assets/images/works/chowol-02.jpg"
    imagePos="50% 45%"
    vlabel={t.hero.vlabel}
  >
    <nav class="mt-8 flex flex-wrap gap-2" aria-label={w.navLabel}>
      {
        CATEGORY_KEYS.map((key) => (
          <a href={`#${key}`} class="btn-ghost !min-h-11 !px-4 text-[0.95rem]">
            {w.categories[key].title} <span class="tabular-nums text-paper/70">{galleryBy(key).length}</span>
          </a>
        ))
      }
    </nav>
  </PageHead>

  <div class="pt-6 pb-16">
    {
      CATEGORY_KEYS.map((key) => (
        <Gallery id={key} columns={4} images={galleryBy(key, lang)}>
          <Fragment slot="title">{w.categories[key].title}</Fragment>
          <Fragment slot="subtitle">{w.categories[key].description}</Fragment>
        </Gallery>
      ))
    }
  </div>

  <ReachPanel />
</Layout>
