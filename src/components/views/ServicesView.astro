---
// 만드는 것 페이지. 한국어(/services)와 다른 언어 페이지가 함께 씁니다.
// 깎는 물건 종류(PRODUCTS), 자동 로구로 작업 순서(실제 영상에서 뽑은 장면), 주문 순서.
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import OrderSteps from '~/components/widgets/OrderSteps.astro';
import TwoLathes from '~/components/widgets/TwoLathes.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import { PRODUCTS } from '~/data/shop';
import { photo } from '~/data/works';
import { localize, useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const s = t.servicesPage;
const worksHref = localize(lang, '/works');

const metadata = {
  title: s.metaTitle,
  description: s.metaDescription,
};

// 자동 로구로 작업 순서 사진 (작업 영상에서 뽑음: 각재 → 깎는 중 → 완성)
const HOW_PHOTOS = ['chowol-11', 'chowol-12', 'chowol-09'];
---

<Layout metadata={metadata} lang={lang}>
  <PageHead lang={lang} title={s.title} lead={s.lead} crumb={t.nav.services} />

  <!-- 깎는 물건 -->
  <section class="px-4 py-16 md:py-24 lg:px-6">
    <div class="mx-auto max-w-7xl">
      <h2 class="display text-[clamp(2rem,4vw,3rem)] text-ink">{t.products.title}</h2>
      <p class="mt-3 text-lg text-muted">{t.products.lead}</p>
      <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          PRODUCTS.map((product) => {
            const item = t.products.items[product.key];
            const work = photo(product.photo, lang);
            return (
              <li class="border-t-2 border-ink pt-4">
                <h3 class="display text-[1.75rem] text-ink">{item.title}</h3>
                <p class="mt-1 text-muted">{item.text}</p>
                <a href={`${worksHref}#${product.anchor}`} class="lift group mt-4 block">
                  <div class="photo aspect-[4/3]">
                    <Image
                      src={work.src}
                      alt={work.alt}
                      widths={[360, 540, 720]}
                      sizes="(max-width: 639px) 90vw, (max-width: 1023px) 45vw, 380px"
                      width={540}
                      height={405}
                      layout="cover"
                      format="webp"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- 자동 로구로 작업 순서 -->
  <section class="on-sign px-4 py-16 md:py-24 lg:px-6">
    <div class="mx-auto max-w-7xl">
      <h2 class="display text-[clamp(2rem,4vw,3rem)] text-white">{s.howTitle}</h2>
      <p class="mt-3 text-lg text-white/85">{s.howLead}</p>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {
          s.how.map((step, index) => (
            <li>
              <div class="photo aspect-[4/5] border-[0.4rem] border-white">
                <Image
                  src={`~/assets/images/works/${HOW_PHOTOS[index]}.jpg`}
                  alt={step.alt}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 767px) 90vw, 380px"
                  width={480}
                  height={600}
                  layout="cover"
                  format="webp"
                  class="h-full w-full object-cover"
                />
              </div>
              <h3 class="mt-4 flex items-baseline gap-3 text-xl font-bold text-white">
                <span class="step-num text-[2.25rem] text-wood" aria-hidden="true">
                  {index + 1}
                </span>
                <span>
                  <span class="sr-only">{index + 1}. </span>
                  {step.title}
                </span>
              </h3>
              <p class="mt-1 text-white/85">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <TwoLathes autoPhoto="~/assets/images/works/chowol-10.jpg">
    <p class="mt-12 border-l-4 border-sign pl-4 text-lg text-ink">{s.sizeNote}</p>
  </TwoLathes>

  <OrderSteps class="bg-white" />

  <ReachPanel />
</Layout>
