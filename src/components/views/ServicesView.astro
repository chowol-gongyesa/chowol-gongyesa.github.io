---
// 만드는 것 페이지. 한국어(/services)와 다른 언어 페이지가 함께 씁니다.
// 페이지 머리 → 깎는 물건 6가지(자세히) → 자동 로구로는 이렇게 깎습니다(작업 영상 장면 3컷)
// → 자동·손 로구로 비교(영상) → 주문 순서 → 연락
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import ProductPlaques from '~/components/widgets/ProductPlaques.astro';
import LatheCompare from '~/components/widgets/LatheCompare.astro';
import OrderSteps from '~/components/widgets/OrderSteps.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const s = t.servicesPage;

const metadata = {
  title: s.metaTitle,
  description: s.metaDescription,
};
// 작업 영상에서 뽑은 장면 (각재 걸기 → 깎기 → 다 깎은 부품)
const HOW_PHOTOS = ['chowol-11', 'chowol-12', 'chowol-09'];
---

<Layout metadata={metadata} lang={lang}>
  <PageHead
    lang={lang}
    title={s.title}
    lead={s.lead}
    crumb={t.nav.services}
    image="~/assets/images/works/chowol-01.jpg"
    imagePos="50% 50%"
    vlabel={t.pill}
  />

  <ProductPlaques lang={lang} detail />

  <!-- 자동 로구로는 이렇게 깎습니다 -->
  <section class="sec-night grain relative overflow-hidden px-5 py-20 md:py-28 lg:px-8" aria-labelledby="how-title">
    <div class="relative z-[2] mx-auto max-w-[76rem]">
      <h2 id="how-title" class="display text-[clamp(2.2rem,4.6vw,3.6rem)] text-paper" data-split>{s.howTitle}</h2>
      <p class="mt-4 text-ivory-2">{s.howLead}</p>
      <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-6">
        {
          s.how.map((step, i) => (
            <li data-reveal>
              <div class="frame">
                <div class="inner wipe grade-strong aspect-[4/3]" style={`--d:${i * 0.15}s`}>
                  <Image
                    src={`~/assets/images/works/${HOW_PHOTOS[i]}.jpg`}
                    alt={step.alt}
                    widths={[360, 560, 760]}
                    sizes="(max-width: 767px) 90vw, 400px"
                    width={760}
                    height={570}
                    layout="cover"
                    format="webp"
                    class="h-full w-full object-cover object-[50%_80%]"
                  />
                </div>
              </div>
              <div class="rise mt-6 flex gap-4" style={`--d:${0.2 + i * 0.15}s`}>
                <span class="step-num shrink-0 !bg-night !text-wood !border-wood/60">{i + 1}</span>
                <div>
                  <h3 class="display text-[1.5rem] text-paper">{step.title}</h3>
                  <p class="mt-1 text-ivory-2">{step.text}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-12 border-l-2 border-verm pl-4 text-ivory-2">{s.sizeNote}</p>
    </div>
  </section>

  <LatheCompare lang={lang} />

  <OrderSteps />

  <ReachPanel />
</Layout>
