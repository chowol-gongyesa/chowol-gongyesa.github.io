---
// 소개 페이지. 한국어(/about)와 다른 언어 페이지가 함께 씁니다.
// 페이지 머리 → 초월공예사 소개(대표 사진) → 고요 속의 집중(대표 이야기) → 걸어온 길(처음은 연수만 새긴 판, 2016년·지금은 사진) → 작업 영상 → 파란 간판이 걸린 곳 → 연락
import { YEARS } from '~/data/years';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import OwnerStory from '~/components/widgets/OwnerStory.astro';
import CraftFilm from '~/components/widgets/CraftFilm.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const a = t.about;

const metadata = {
  title: a.metaTitle,
  description: a.metaDescription,
};
// 걸어온 길의 사진 (40년 전 = 손 로구로, 2016년 = 지금 작업장, 지금 = 자동 로구로)
// 걸어온 길 사진: 처음은 옛 사진이 없어 연수를 새긴 판으로(남의 사진을 옛 사진처럼 보이게 하지 않음) → 2016년 지금 자리 → 지금
const TIMELINE_PHOTOS = ['', 'chowol-shop', 'chowol-10'];
---

<Layout metadata={metadata} lang={lang}>
  <PageHead
    lang={lang}
    title={a.title}
    lead={a.lead}
    crumb={t.nav.about}
    image="~/assets/images/works/chowol-owner-2.jpg"
    imagePos="50% 20%"
    brandTitle={lang === 'ko'}
    vlabel={t.hero.vlabel}
  />

  <!-- 초월공예사 소개 -->
  <section class="px-5 py-20 md:py-28 lg:px-8" aria-labelledby="about-intro">
    <div class="mx-auto grid max-w-[76rem] items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-20">
      <div data-reveal>
        <p class="eyebrow rise">{a.eyebrow}</p>
        <h2 id="about-intro" class="display rise mt-4 text-[clamp(2.2rem,4.6vw,3.6rem)]" style="--d:0.1s">{a.heading}</h2>
        <div class="mt-8 space-y-6 text-[1.1rem] leading-[1.95] text-ivory-2 [&_b]:font-bold [&_b]:text-ivory">
          {a.paragraphs.map((p, i) => <p class="rise" style={`--d:${0.15 + i * 0.12}s`} set:html={p} />)}
        </div>
      </div>
      <figure data-reveal>
        <div class="frame mx-auto max-w-[30rem]">
          <div class="inner wipe aspect-[4/5]">
            <Image
              src="~/assets/images/works/chowol-06.jpg"
              alt={a.photoAlt}
              widths={[400, 640, 900]}
              sizes="(max-width: 1023px) 88vw, 480px"
              width={900}
              height={1125}
              layout="cover"
              format="webp"
              class="parallax h-full w-full object-cover"
            />
          </div>
        </div>
        <figcaption class="mx-auto mt-3 max-w-[30rem] text-[0.95rem] text-ivory-2">{a.photoAlt}</figcaption>
      </figure>
    </div>
  </section>

  <OwnerStory showLink={false} class="sec-wood" />

  <!-- 걸어온 길 -->
  <section class="sec-night grain relative overflow-hidden px-5 py-20 md:py-28 lg:px-8" aria-labelledby="timeline-title">
    <div class="relative z-[2] mx-auto max-w-[76rem]">
      <p class="eyebrow">{a.timelineEyebrow}</p>
      <h2 id="timeline-title" class="display mt-4 text-[clamp(2.2rem,4.6vw,3.6rem)]" data-split>{a.timelineTitle}</h2>
      <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-7" data-reveal>
        {
          a.timeline.map((item, i) => (
            <li class="rise" style={`--d:${0.15 + i * 0.18}s`}>
              <div class="frame">
                {i === 0 ? (
                  <div class="inner sec-wood flex aspect-[4/3] flex-col items-center justify-center text-center" aria-hidden="true">
                    <span class="display text-[clamp(4.5rem,9vw,7rem)] leading-none text-gold-2 [text-shadow:0_4px_18px_rgb(0_0_0/0.6)]">
                      {YEARS}<span class:list={['text-[0.42em]', lang === 'en' && 'ml-[0.2em]']}>{a.timelineUnit}</span>
                    </span>
                    <span class="mt-3 h-px w-14 bg-gold/70" />
                    <span class="display mt-3 text-[1.15rem] tracking-[0.3em] text-gold-2">{a.timelineYears}</span>
                  </div>
                ) : (
                  <div class="inner aspect-[4/3]">
                    <Image
                      src={`~/assets/images/works/${TIMELINE_PHOTOS[i]}.jpg`}
                      alt={item.alt}
                      widths={[360, 540, 720]}
                      sizes="(max-width: 767px) 90vw, 400px"
                      width={720}
                      height={540}
                      layout="cover"
                      format="webp"
                      class="h-full w-full object-cover"
                    />
                  </div>
                )}
              </div>
              <p class="display mt-6 text-[clamp(1.7rem,3vw,2.3rem)] text-gold-2">{item.when}</p>
              <p class="mt-2 text-[1.05rem] leading-[1.85] text-ivory-2">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CraftFilm lang={lang} compact />

  <!-- 작업장 -->
  <section class="sec-wood px-5 py-20 md:py-28 lg:px-8" aria-labelledby="place-title">
    <div class="mx-auto grid max-w-[76rem] gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] md:items-center lg:gap-16">
      <div class="grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] gap-4" data-reveal>
        <div class="frame">
          <!-- 높이는 너비에서(6:5) 정하고, 옆 사진 칸이 이 높이에 맞춰 늘어남 (h-full을 같이 주면 칸보다 넓어져 오른쪽이 잘림) -->
          <div class="inner wipe aspect-[6/5]">
            <Image
              src="~/assets/images/works/chowol-05.jpg"
              alt={a.signAlt}
              widths={[400, 640, 800]}
              sizes="(max-width: 767px) 55vw, 420px"
              width={800}
              height={656}
              layout="cover"
              format="webp"
              class="h-full w-full object-cover object-[50%_22%]"
            />
          </div>
        </div>
        <div class="frame">
          <!-- 이 사진은 칸 높이를 정하지 않고(absolute) 왼쪽 간판 사진(6:5)이 정한 높이를 채움 → 두 사진의 위아래가 맞음 -->
          <div class="inner wipe h-full" style="--d:0.15s">
            <Image
              src="~/assets/images/works/chowol-08.jpg"
              alt={a.blanksAlt}
              widths={[300, 480]}
              sizes="(max-width: 767px) 38vw, 300px"
              width={480}
              height={720}
              layout="cover"
              format="webp"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
      <div>
        <p class="eyebrow">{a.placeEyebrow}</p>
        <h2 id="place-title" class="display mt-4 text-[clamp(2.2rem,4.6vw,3.6rem)]" data-split>{a.placeTitle}</h2>
        <p class="mt-5 text-[1.08rem] leading-[1.95] text-ivory-2">{a.placeText}</p>
        <p class="display mt-6 text-[1.3rem]">{t.shop.address}</p>
      </div>
    </div>
  </section>

  <ReachPanel />
</Layout>
