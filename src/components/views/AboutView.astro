---
// 소개 페이지. 한국어(/about)와 다른 언어 페이지가 함께 씁니다.
// 페이지 머리 → 초월공예사 소개 → 대표 이야기 → 걸어온 길 → 작업장(사진) → 연락
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import OwnerStory from '~/components/widgets/OwnerStory.astro';
import Marquee from '~/components/widgets/Marquee.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import { photo } from '~/data/works';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const a = t.about;

const metadata = {
  title: a.metaTitle,
  description: a.metaDescription,
};
const store = photo('chowol-04', lang);
---

<Layout metadata={metadata} lang={lang}>
  <PageHead
    lang={lang}
    title={a.title}
    lead={a.lead}
    crumb={t.nav.about}
    image="~/assets/images/works/chowol-10.jpg"
    imagePos="50% 55%"
    vlabel={t.hero.vlabel}
  />

  <section class="px-5 py-20 md:py-28 lg:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-20">
      <div class="space-y-6 text-[1.1rem] leading-[2] text-ink-soft [&_b]:font-bold [&_b]:text-ink" data-reveal>
        {a.paragraphs.map((p, i) => <p class="rise" style={`--d:${i * 0.12}s`} set:html={p} />)}
      </div>
      <div data-reveal>
        <div class="frame mx-auto max-w-[30rem]">
          <div class="inner wipe aspect-[4/5]">
            <Image
              src="~/assets/images/works/chowol-06.jpg"
              alt={a.photoAlt}
              widths={[400, 640, 900]}
              sizes="(max-width: 1023px) 88vw, 480px"
              width={900}
              height={1125}
              layout="cover"
              format="webp"
              class="parallax h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Marquee lang={lang} />

  <OwnerStory showLink={false} class="sec-paper2" />

  <!-- 걸어온 길 -->
  <section class="sec-night grain relative overflow-hidden px-5 py-20 md:py-28 lg:px-8" aria-labelledby="timeline-title">
    <div class="relative z-[2] mx-auto max-w-5xl">
      <h2 id="timeline-title" class="display text-[clamp(2.2rem,4.8vw,3.8rem)] text-paper" data-split>{a.timelineTitle}</h2>
      <ol class="relative mt-14 border-l border-wood/30 pl-8 md:pl-12" data-reveal>
        {
          a.timeline.map((item, i) => (
            <li class="rise relative pb-12 last:pb-0" style={`--d:${0.15 + i * 0.2}s`}>
              <span class="absolute top-2 -left-[2.42rem] h-3.5 w-3.5 rotate-45 bg-verm md:-left-[3.42rem]" aria-hidden="true" />
              <p class="display text-[clamp(1.8rem,3.6vw,2.6rem)] text-wood">{item.when}</p>
              <p class="mt-2 max-w-2xl text-[1.08rem] text-paper/85">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 작업장 -->
  <section class="px-5 py-20 md:py-28 lg:px-8" aria-labelledby="place-title">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] md:items-center lg:gap-16">
      <div class="grid grid-cols-[1.4fr_1fr] gap-4" data-reveal>
        <div class="frame">
          <div class="inner wipe aspect-[6/5] h-full">
            <Image
              src={store.src}
              alt={a.placeTitle + ': ' + store.alt}
              widths={[400, 640, 900]}
              sizes="(max-width: 767px) 55vw, 420px"
              width={900}
              height={750}
              layout="cover"
              format="webp"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <div class="frame">
          <div class="inner wipe h-full" style="--d:0.15s">
            <Image
              src="~/assets/images/works/chowol-05.jpg"
              alt={a.signAlt}
              widths={[300, 480]}
              sizes="(max-width: 767px) 38vw, 300px"
              width={480}
              height={720}
              layout="cover"
              format="webp"
              class="h-full w-full object-cover object-[50%_30%]"
            />
          </div>
        </div>
      </div>
      <div>
        <h2 id="place-title" class="display text-[clamp(2.2rem,4.8vw,3.8rem)] text-ink" data-split>{a.placeTitle}</h2>
        <p class="mt-5 text-[1.08rem] leading-[2] text-ink-soft">{a.placeText}</p>
        <p class="display mt-6 text-[1.3rem] text-ink">{t.shop.address}</p>
      </div>
    </div>
  </section>

  <ReachPanel />
</Layout>
