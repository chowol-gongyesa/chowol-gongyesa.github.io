---
// 소개 페이지. 한국어(/about)와 다른 언어 페이지가 함께 씁니다.
// ⚠️ 문장은 Claude가 쓴 것 → 정영순 대표님께 확인받기 (특히 청각장애 이야기)
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import OwnerStory from '~/components/widgets/OwnerStory.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const a = t.about;

const metadata = {
  title: a.metaTitle,
  description: a.metaDescription,
};
---

<Layout metadata={metadata} lang={lang}>
  <PageHead lang={lang} title={a.title} lead={a.lead} crumb={t.nav.about} />

  <section class="px-4 py-16 md:py-24 lg:px-6">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="about-copy">
        {a.paragraphs.map((p) => <p class="mb-6 text-lg text-ink/85 md:text-xl md:leading-relaxed" set:html={p} />)}
      </div>
      <div class="photo aspect-[4/5] max-h-[36rem] w-full md:max-w-[28rem] md:justify-self-end">
        <Image
          src="~/assets/images/works/chowol-06.jpg"
          alt={a.photoAlt}
          widths={[400, 600, 800]}
          sizes="(max-width: 767px) 90vw, 448px"
          width={600}
          height={750}
          layout="cover"
          format="webp"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <OwnerStory showLink={false} class="bg-white" />

  <!-- 작업장 -->
  <section class="px-4 pt-16 md:pt-24 lg:px-6">
    <div class="mx-auto grid max-w-7xl items-end gap-8 md:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <h2 class="display text-[clamp(2rem,4vw,3rem)] text-ink">{a.placeTitle}</h2>
        <p class="mt-4 max-w-xl text-lg text-muted">{a.placeText}</p>
      </div>
      <div class="photo aspect-[4/5] max-h-[30rem] w-full md:max-w-[24rem] md:justify-self-end">
        <Image
          src="~/assets/images/works/chowol-05.jpg"
          alt={t.visit.sign}
          widths={[360, 540, 720]}
          sizes="(max-width: 767px) 90vw, 384px"
          width={540}
          height={675}
          layout="cover"
          format="webp"
          class="h-full w-full object-cover object-top"
        />
      </div>
    </div>
  </section>

  <VisitInfo />

  <ReachPanel />
</Layout>

<style>
  .about-copy :global(b) {
    color: var(--sign);
    font-weight: 700;
  }
</style>
