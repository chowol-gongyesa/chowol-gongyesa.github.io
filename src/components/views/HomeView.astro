---
// 홈. 한국어(/)와 다른 언어 페이지(/en/ 등)가 함께 씁니다. 위에서부터:
// 입장 화면(첫 방문, 눌러야 들어감) → 첫 화면 영상 → 작업 영상(자막, 장면 목록) → 대표 이야기
// → 자동·손 로구로 비교 → 작업 과정(사진 4장) → 깎는 물건 → 깎아 낸 것들(작품 사진)
// → 나무 고르기 → 주문 순서 → 연락 → 찾아오시는 길
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Intro from '~/components/widgets/Intro.astro';
import HeroCinema from '~/components/widgets/HeroCinema.astro';
import CraftFilm from '~/components/widgets/CraftFilm.astro';
import OwnerStory from '~/components/widgets/OwnerStory.astro';
import LatheCompare from '~/components/widgets/LatheCompare.astro';
import ProcessStory from '~/components/widgets/ProcessStory.astro';
import ProductPlaques from '~/components/widgets/ProductPlaques.astro';
import WorksShowcase from '~/components/widgets/WorksShowcase.astro';
import PhotoBand from '~/components/widgets/PhotoBand.astro';
import OrderSteps from '~/components/widgets/OrderSteps.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import { SHOP } from '~/data/shop';
import { localize, useT, type Lang } from '~/i18n';
import { getCanonical } from '~/utils/permalinks';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const metadata = {
  title: t.home.metaTitle,
  description: t.home.metaDescription,
  ignoreTitleTemplate: true,
};

// 검색엔진에 가게 정보를 알려 주는 구조화 데이터 (주소·전화·영업시간)
// 전화는 상담전화 하나만(검색 결과의 '전화' 단추가 대표 휴대폰·작업장으로 걸리지 않게). 대표 휴대폰은 문자 연락처로 따로
const home = String(getCanonical(localize(lang, '/')));
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${home}#business`,
  name: lang === 'ko' ? SHOP.name : `${t.brand} (${SHOP.name})`,
  url: home,
  telephone: '+82-10-8548-7264',
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer service', telephone: '+82-10-8548-7264', availableLanguage: ['ko'] },
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: '+82-10-5216-4554',
      description: lang === 'ko' ? '대표 휴대폰 — 문자로 연락해 주세요' : "Owner's mobile — please contact by text message (SMS)",
    },
  ],
  faxNumber: '+82-31-797-0784',
  founder: { '@type': 'Person', name: lang === 'ko' ? SHOP.owner : 'Jeong Yeong-sun' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '경충대로963번길 35',
    addressLocality: '광주시 초월읍',
    addressRegion: '경기도',
    addressCountry: 'KR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
};

---

<Layout metadata={metadata} lang={lang} headerOver>
  <StructuredData slot="head" schema={structuredData} />
  <Intro lang={lang} />
  <HeroCinema lang={lang} />
  <CraftFilm lang={lang} />
  <OwnerStory />
  <LatheCompare lang={lang} table={false} />
  <ProcessStory lang={lang} />
  <PhotoBand lang={lang} />
  <ProductPlaques lang={lang} />
  <WorksShowcase lang={lang} />
  <OrderSteps />
  <ReachPanel />
  <VisitInfo />
</Layout>
