---
// 주문·문의 페이지. 한국어(/contact)와 다른 언어 페이지가 함께 씁니다.
// 주문서는 서버 없이 작성 내용을 문자 메시지로 만들어 정영순 대표 휴대폰(문자)으로 보냅니다.
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import ShopFAQ from '~/components/widgets/ShopFAQ.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import { PRODUCTS, shopFor } from '~/data/shop';
import { localize, useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const c = t.contact;
const ko = useT('ko').contact;
const shop = shopFor(lang);

const metadata = {
  title: c.metaTitle,
  description: c.metaDescription,
};

// 문자 내용의 항목 이름: 대표님이 읽기 쉽게 한국어로, 외국어 페이지면 그 언어를 함께 적습니다.
const label = (key: 'name' | 'phone' | 'type' | 'qty' | 'size' | 'due' | 'message') =>
  lang === 'ko' ? ko[key] : `${ko[key]} / ${c[key]}`;
const labels = {
  header: lang === 'ko' ? `[초월공예사 ${ko.msgHeader}]` : `[초월공예사 ${ko.msgHeader} · ${c.msgHeader}]`,
  name: label('name'),
  phone: label('phone'),
  type: label('type'),
  qty: label('qty'),
  size: label('size'),
  due: label('due'),
  message: label('message'),
  prompt: c.copyPrompt,
};
// '만들 물건' 고르기: 외국어 페이지에서도 대표님이 알아보게 한국어 이름을 함께
const koItems = useT('ko').products.items;
const typeOptions = PRODUCTS.map((p) =>
  lang === 'ko' ? koItems[p.key].title : `${t.products.items[p.key].title} (${koItems[p.key].title})`
);
---

<Layout metadata={metadata} lang={lang}>
  <ReachPanel asPageHead showFormLink={false}>
    <Breadcrumbs
      slot="top"
      class="crumbs -ml-1 mb-6"
      items={[{ text: t.nav.home, href: localize(lang, '/'), icon: 'tabler:home' }, { text: t.nav.contact }]}
    />
  </ReachPanel>
  <div class="rail-strip" aria-hidden="true"></div>

  <!-- 주문서 -->
  <section id="order" class="px-5 py-20 md:py-28 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <h2 class="display text-[clamp(2.2rem,4.8vw,3.8rem)] text-ink" data-split>{c.formTitle}</h2>
        <span class="seal mt-6" style="--seal:3.4rem" aria-hidden="true">초월</span>
        <p class="mt-4 text-muted [&_b]:font-bold [&_b]:text-ink" set:html={c.formLead} />
        <p class="display mt-4 text-[1.6rem] tabular-nums text-ink">{shop.mobile.label}</p>
      </div>

      <form id="order-form" class="grid gap-6 border-t-2 border-ink bg-[rgb(255_252_245/0.45)] p-5 pt-7 sm:grid-cols-2 md:p-8" novalidate>
        <label class="block">
          <span class="text-sm font-bold text-ink">{c.name} <span class="text-verm" aria-label={c.required}>*</span></span>
          <input name="name" required autocomplete="name" class="field mt-1.5" placeholder={c.namePh} />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-ink">{c.phone} <span class="text-verm" aria-label={c.required}>*</span></span>
          <input
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            inputmode="tel"
            class="field mt-1.5"
            placeholder={c.phonePh}
          />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-ink">{c.type}</span>
          <select name="type" class="field mt-1.5">
            {typeOptions.map((option) => <option>{option}</option>)}
            <option>{c.unsure}</option>
          </select>
        </label>
        <label class="block">
          <span class="text-sm font-bold text-ink">{c.qty}</span>
          <input name="qty" autocomplete="off" class="field mt-1.5" placeholder={c.qtyPh} />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-ink">{c.size}</span>
          <input name="size" autocomplete="off" class="field mt-1.5" placeholder={c.sizePh} />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-ink">{c.due}</span>
          <input name="due" autocomplete="off" class="field mt-1.5" placeholder={c.duePh} />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-sm font-bold text-ink">{c.message} <span class="text-verm" aria-label={c.required}>*</span></span>
          <textarea name="message" required rows="5" autocomplete="off" class="field mt-1.5" placeholder={c.messagePh}
          ></textarea>
        </label>

        <p id="order-error" class="hidden font-bold text-verm sm:col-span-2" role="alert">{c.error}</p>

        <div class="flex flex-wrap gap-3 sm:col-span-2">
          <button type="submit" data-action="sms" class="btn-primary">
            <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{c.sms}
          </button>
          <button type="submit" data-action="copy" class="btn-secondary">
            <Icon name="tabler:copy" class="h-5 w-5" aria-hidden="true" />{c.copy}
          </button>
        </div>
        <p id="order-copied" class="hidden font-bold text-verm sm:col-span-2" role="status">
          {c.copied(shop.mobile.label)}
        </p>
      </form>
    </div>
  </section>

  <ShopFAQ class="sec-paper2" />

  <VisitInfo />
</Layout>

<script is:inline define:vars={{ smsNumber: shop.mobile.sms.replace('sms:', ''), labels }}>
  const setup = () => {
    const form = document.getElementById('order-form');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const error = document.getElementById('order-error');
    const copied = document.getElementById('order-copied');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const action = event.submitter?.dataset.action ?? 'sms';
      const data = new FormData(form);
      const get = (key) => String(data.get(key) ?? '').trim();
      const missing = ['name', 'phone', 'message'].filter((key) => !get(key));
      form
        .querySelectorAll('[required]')
        .forEach((el) => el.setAttribute('aria-invalid', String(missing.includes(el.name))));
      if (missing.length) {
        error.classList.remove('hidden');
        form.querySelector(`[name="${missing[0]}"]`)?.focus();
        return;
      }
      error.classList.add('hidden');

      const lines = [
        labels.header,
        `${labels.name}: ${get('name')}`,
        `${labels.phone}: ${get('phone')}`,
        `${labels.type}: ${get('type')}`,
        get('qty') && `${labels.qty}: ${get('qty')}`,
        get('size') && `${labels.size}: ${get('size')}`,
        get('due') && `${labels.due}: ${get('due')}`,
        `${labels.message}: ${get('message')}`,
      ].filter(Boolean);
      const text = lines.join('\n');

      if (action === 'copy') {
        try {
          await navigator.clipboard.writeText(text);
          copied.classList.remove('hidden');
        } catch {
          window.prompt(labels.prompt, text);
        }
        return;
      }
      const isApple = /iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent);
      window.location.href = `sms:${smsNumber}${isApple ? '&' : '?'}body=${encodeURIComponent(text)}`;
    });
  };
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
