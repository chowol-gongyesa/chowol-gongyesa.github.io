---
// 주문·문의 페이지. 한국어(/contact)와 다른 언어 페이지가 함께 씁니다.
// 주문서는 서버 없이 작성 내용을 문자 메시지로 만들어 정영순 대표 휴대폰(문자)으로 보냅니다.
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import ReachPanel from '~/components/widgets/ReachPanel.astro';
import ShopFAQ from '~/components/widgets/ShopFAQ.astro';
import VisitInfo from '~/components/widgets/VisitInfo.astro';
import { PRODUCTS, shopFor } from '~/data/shop';
import { useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const c = t.contact;
const ko = useT('ko').contact;
const shop = shopFor(lang);

const metadata = {
  title: c.metaTitle,
  description: c.metaDescription,
};

// 문자 내용의 항목 이름: 대표님이 읽기 쉽게 한국어로, 외국어 페이지면 그 언어를 함께 적습니다.
const label = (key: 'name' | 'phone' | 'type' | 'qty' | 'size' | 'due' | 'message') =>
  lang === 'ko' ? ko[key] : `${ko[key]} / ${c[key]}`;
const labels = {
  header: lang === 'ko' ? `[초월공예사 ${ko.msgHeader}]` : `[초월공예사 ${ko.msgHeader} · ${c.msgHeader}]`,
  name: label('name'),
  phone: label('phone'),
  type: label('type'),
  qty: label('qty'),
  size: label('size'),
  due: label('due'),
  message: label('message'),
  prompt: c.copyPrompt,
};
// '만들 물건' 고르기: 외국어 페이지에서도 대표님이 알아보게 한국어 이름을 함께
const koItems = useT('ko').products.items;
const typeOptions = PRODUCTS.map((p) =>
  lang === 'ko' ? koItems[p.key].title : `${t.products.items[p.key].title} (${koItems[p.key].title})`
);
---

<Layout metadata={metadata} lang={lang}>
  <PageHead
    lang={lang}
    title={c.title}
    lead={c.lead}
    crumb={t.nav.contact}
    image="~/assets/images/works/column-154.jpg"
    imagePos="50% 55%"
    vlabel={t.hero.vlabel}
  />
  <ReachPanel bare showFormLink={false} />
  <div class="rail-strip" aria-hidden="true"></div>

  <!-- 주문서 -->
  <section id="order" class="px-5 py-20 md:py-28 lg:px-8">
    <div class="mx-auto grid max-w-[76rem] gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <h2 class="display text-[clamp(2.2rem,4.6vw,3.6rem)] text-ink" data-split>{c.formTitle}</h2>
        <p class="mt-4 text-ivory-2 [&_b]:font-bold [&_b]:text-ivory" set:html={c.formLead} />
        <p class="display mt-4 text-[1.6rem] tabular-nums text-ink">{shop.mobile.label}</p>
      </div>

      <form
        id="order-form"
        class="grid gap-6 border border-[var(--line)] border-t-gold bg-black/25 p-5 pt-7 sm:grid-cols-2 md:p-8"
        novalidate
        data-sms={shop.mobile.number}
        data-labels={JSON.stringify(labels)}
        data-error={c.error}
      >
        <!-- 빠진 칸 알림: 맨 위에 둠 (보내기를 누르면 첫 빠진 칸으로 초점이 가므로 바로 위에 보이게) -->
        <p id="order-error" class="hidden font-bold text-verm sm:col-span-2" role="alert"></p>
        <label class="block">
          <span class="text-[0.97rem] font-bold text-ivory">{c.name} <span class="text-verm" aria-hidden="true">*</span></span>
          <input name="name" required aria-describedby="order-error" autocomplete="name" class="field mt-1.5" placeholder={c.namePh} />
        </label>
        <label class="block">
          <span class="text-[0.97rem] font-bold text-ivory">{c.phone} <span class="text-verm" aria-hidden="true">*</span></span>
          <input
            name="phone"
            type="tel"
            required
            aria-describedby="order-error"
            autocomplete="tel"
            inputmode="tel"
            class="field mt-1.5"
            placeholder={c.phonePh}
          />
        </label>
        <label class="block">
          <span class="text-[0.97rem] font-bold text-ivory">{c.type}</span>
          <select name="type" class="field mt-1.5">
            <option value="" selected>{c.choose}</option>
            {typeOptions.map((option) => <option>{option}</option>)}
            <option>{c.unsure}</option>
          </select>
        </label>
        <label class="block">
          <span class="text-[0.97rem] font-bold text-ivory">{c.qty}</span>
          <input name="qty" autocomplete="off" class="field mt-1.5" placeholder={c.qtyPh} />
        </label>
        <label class="block">
          <span class="text-[0.97rem] font-bold text-ivory">{c.size}</span>
          <input name="size" autocomplete="off" class="field mt-1.5" placeholder={c.sizePh} />
        </label>
        <label class="block">
          <span class="text-[0.97rem] font-bold text-ivory">{c.due}</span>
          <input name="due" autocomplete="off" class="field mt-1.5" placeholder={c.duePh} />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-[0.97rem] font-bold text-ivory">{c.message} <span class="text-verm" aria-hidden="true">*</span></span>
          <textarea name="message" required aria-describedby="order-error" rows="5" autocomplete="off" class="field mt-1.5" placeholder={c.messagePh}
          ></textarea>
        </label>

        <p class="flex gap-2 border-l-2 border-gold pl-3 text-ivory-2 sm:col-span-2">
          <Icon name="tabler:photo" class="mt-1 h-5 w-5 shrink-0 text-gold-2" aria-hidden="true" />{c.attachNote}
        </p>

        <div class="flex flex-wrap gap-3 sm:col-span-2">
          <button type="submit" data-action="sms" class="btn-primary w-full sm:w-auto">
            <Icon name="tabler:message" class="h-5 w-5" aria-hidden="true" />{c.sms}
          </button>
          <button type="submit" data-action="copy" class="btn-secondary w-full sm:w-auto">
            <Icon name="tabler:copy" class="h-5 w-5" aria-hidden="true" />{c.copy}
          </button>
        </div>
        <p id="order-copied" class="hidden font-bold text-verm sm:col-span-2" role="status" data-text={c.copied(shop.mobile.label)}></p>
      </form>
    </div>
  </section>

  <ShopFAQ class="sec-paper2" />

  <VisitInfo />

  <script>
    // 주문서: 문자 앱에 주문 내용을 채워 열거나(휴대폰), 내용을 복사(컴퓨터). 받는 번호·글자는 form의 data-*에서
    // 페이지에 오는 것은 astro:page-load로 잡고, 스크립트 자체는 문서마다 한 번만 돎
    const say = (el: HTMLElement, text: string) => {
      // 화면 낭독기가 알림을 확실히 읽도록, 보이게 한 뒤에 글을 넣음
      el.classList.remove('hidden');
      el.textContent = '';
      requestAnimationFrame(() => (el.textContent = text));
    };
    const setup = () => {
      const form = document.getElementById('order-form') as HTMLFormElement | null;
      if (!form || form.dataset.ready) return;
      form.dataset.ready = '1';
      const error = document.getElementById('order-error')!;
      const copied = document.getElementById('order-copied')!;
      const labels = JSON.parse(form.dataset.labels || '{}') as Record<string, string>;
      const smsNumber = form.dataset.sms || '';

      // 고쳐 쓰기 시작하면 빨간 표시를 지우고, 빠진 칸이 다 채워지면 위의 알림도 지움
      form.addEventListener('input', (e) => {
        const el = e.target as HTMLInputElement;
        if (el.getAttribute('aria-invalid') === 'true' && el.value.trim()) el.setAttribute('aria-invalid', 'false');
        if (!form.querySelector('[aria-invalid="true"]')) {
          error.classList.add('hidden');
          error.textContent = '';
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const action = ((event as SubmitEvent).submitter as HTMLElement | null)?.dataset.action ?? 'sms';
        const data = new FormData(form);
        const get = (key: string) => String(data.get(key) ?? '').trim();
        // 연락처는 숫자가 8자리 이상이어야 함 (글자만 적은 경우 막기)
        const phoneOk = get('phone').replace(/\D/g, '').length >= 8;
        const missing = ['name', 'phone', 'message'].filter((key) => !get(key) || (key === 'phone' && !phoneOk));
        form
          .querySelectorAll<HTMLInputElement>('[required]')
          .forEach((el) => el.setAttribute('aria-invalid', String(missing.includes(el.name))));
        if (missing.length) {
          say(error, form.dataset.error || '');
          form.querySelector<HTMLElement>(`[name="${missing[0]}"]`)?.focus();
          return;
        }
        error.classList.add('hidden');
        error.textContent = '';

        const lines = [
          labels.header,
          `${labels.name}: ${get('name')}`,
          `${labels.phone}: ${get('phone')}`,
          get('type') && `${labels.type}: ${get('type')}`,
          get('qty') && `${labels.qty}: ${get('qty')}`,
          get('size') && `${labels.size}: ${get('size')}`,
          get('due') && `${labels.due}: ${get('due')}`,
          `${labels.message}: ${get('message')}`,
        ].filter(Boolean);
        const text = lines.join('\n');

        if (action === 'copy') {
          try {
            await navigator.clipboard.writeText(text);
            say(copied, copied.dataset.text || '');
          } catch {
            window.prompt(labels.prompt, text);
          }
          return;
        }
        // '?&body=' 는 아이폰·안드로이드 모두 알아듣는 형식
        window.location.href = `sms:${smsNumber}?&body=${encodeURIComponent(text)}`;
      });
    };
    document.addEventListener('astro:page-load', setup);
  </script>
</Layout>
