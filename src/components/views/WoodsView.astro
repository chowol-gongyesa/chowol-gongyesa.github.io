---
// 나무 고르기 페이지. 한국어(/woods)와 다른 언어 페이지가 함께 씁니다. 나무 목록은 src/data/woods.ts
// 나무마다 그 나무 색으로 깎은 동자와 결 무늬 견본판을 그려 보여 줍니다.
import { Icon } from 'astro-icon/components';
import { getAsset } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/widgets/PageHead.astro';
import { WOODS, PICKS } from '~/data/woods';
import { shopFor } from '~/data/shop';
import { verticalPath } from '~/utils/baluster';
import { localize, useT, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const w = t.woods;
const shop = shopFor(lang);
const byKey = new Map(WOODS.map((wood) => [wood.key, wood]));
// 단단함 옆 설명: 무름(1~2), 아주 단단(4~5)만 붙이고 보통(3)은 숫자만
const hardLabel = (hard: number) => (hard <= 2 ? w.hardLow : hard >= 4 ? w.hardHigh : '');
const baluster = verticalPath();

// 견본판·동자의 나뭇결 그림: public/tex/woods/<나무>.webp, <나무>-v.webp (만드는 법: scripts/woods.py)

const metadata = {
  title: w.metaTitle,
  description: w.metaDescription,
};
---

<Layout metadata={metadata} lang={lang}>
  <PageHead
    lang={lang}
    title={w.title}
    lead={w.lead}
    crumb={t.nav.woods}
    image="~/assets/images/works/column-10.jpg"
    imagePos="50% 60%"
    vlabel={t.hero.vlabel}
  >
    <nav class="mt-8 flex flex-wrap gap-2" aria-label={w.jump}>
      {
        WOODS.map((wood) => (
          <a
            href={`#${wood.key}`}
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-gold/40 px-4 text-[0.95rem] text-ivory hover:border-gold-2 hover:bg-gold/10"
          >
            <i class="h-3 w-3 rounded-full" style={`background:linear-gradient(135deg,${wood.colors[0]},${wood.colors[1]})`} aria-hidden="true" />
            {wood.name[lang]}
          </a>
        ))
      }
    </nav>
  </PageHead>

  <section class="px-5 py-20 md:py-28 lg:px-8">
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <symbol id="wd-shape" viewBox="0 0 36 300"><path d={baluster}></path></symbol>
    </svg>
    <ul class="mx-auto grid max-w-[76rem] gap-8 lg:grid-cols-2">
      {
        WOODS.map((wood, i) => (
          <li id={wood.key} data-reveal>
            <article class="rise grid h-full grid-cols-[5.5rem_minmax(0,1fr)] gap-5 border border-[var(--line)] bg-black/25 p-5 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-7 sm:p-7" style={`--d:${(i % 2) * 0.12}s`}>
              <div class="flex flex-col items-center gap-4" aria-hidden="true">
                <svg viewBox="0 0 36 300" class="h-56 w-auto drop-shadow-[0_8px_10px_rgb(0_0_0/0.35)] sm:h-64">
                  <defs>
                    <!-- 그 나무의 세로 결 그림을 입히고, 둥글게 깎인 느낌으로 양쪽을 어둡게 -->
                    <pattern id={`wt-${wood.key}`} patternUnits="userSpaceOnUse" width="36" height="300">
                      <image href={getAsset(`/tex/woods/${wood.key}-v.webp`)} width="36" height="300" preserveAspectRatio="none" />
                    </pattern>
                    <linearGradient id={`ws-${wood.key}`} x1="0" x2="1">
                      <stop offset="0" stop-color="#000" stop-opacity="0.5" />
                      <stop offset="0.32" stop-color="#fff" stop-opacity="0.16" />
                      <stop offset="0.55" stop-color="#000" stop-opacity="0" />
                      <stop offset="1" stop-color="#000" stop-opacity="0.55" />
                    </linearGradient>
                  </defs>
                  <use href="#wd-shape" fill={wood.colors[0]} />
                  <use href="#wd-shape" fill={`url(#wt-${wood.key})`} />
                  <use href="#wd-shape" fill={`url(#ws-${wood.key})`} />
                </svg>
                <img
                  src={getAsset(`/tex/woods/${wood.key}.webp`)}
                  alt=""
                  width="480"
                  height="240"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[2/1] w-full object-cover shadow-[inset_0_0_0_1px_rgb(0_0_0/0.3)]"
                />
              </div>
              <div>
                <h2 class="display text-[1.8rem] leading-tight">{wood.name[lang]}</h2>
                <p class="text-[0.95rem] text-muted italic" lang="la" translate="no">{wood.latin}</p>
                <dl class="mt-5 grid min-w-0 grid-cols-[minmax(0,1fr)] gap-3 text-[0.97rem]">
                  <div>
                    <dt class="font-bold text-verm">{w.look}</dt>
                    <dd class="text-ink">{wood.look[lang]}</dd>
                  </div>
                  <div>
                    <dt class="font-bold text-verm">{w.hard}</dt>
                    <dd class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <span class="flex gap-1" aria-hidden="true">
                        {Array.from({ length: 5 }, (_, n) => (
                          <i class:list={['h-2.5 w-4 sm:w-5', n < wood.hard ? 'bg-gold' : 'bg-ivory/15']} />
                        ))}
                      </span>
                      <span class="whitespace-nowrap text-[0.95rem] text-muted">
                        {wood.hard}/5{hardLabel(wood.hard) && `, ${hardLabel(wood.hard)}`}
                      </span>
                    </dd>
                  </div>
                  <div>
                    <dt class="font-bold text-verm">{w.density}</dt>
                    <dd class="text-ink tabular-nums">
                      {wood.density} <span class="text-[0.95rem] text-muted">({w.densityUnit})</span>
                    </dd>
                  </div>
                  <div>
                    <dt class="font-bold text-verm">{w.uses}</dt>
                    <dd class="text-ink">{wood.uses[lang]}</dd>
                  </div>
                </dl>
                <p class="mt-5 text-ink-soft">{wood.feel[lang]}</p>
                <details class="faq-item mt-4 border-t border-[var(--line)]">
                  <summary class="!min-h-11 !py-2 !text-[0.98rem]">
                    <span>
                      {w.turning}, {w.care}
                    </span>
                    <Icon name="tabler:plus" class="faq-icon h-5 w-5 shrink-0 text-verm" aria-hidden="true" />
                  </summary>
                  <dl class="space-y-3 pb-2 text-[0.97rem]">
                    <div>
                      <dt class="font-bold text-ink">{w.turning}</dt>
                      <dd class="text-ink-soft">{wood.turning[lang]}</dd>
                    </div>
                    <div>
                      <dt class="font-bold text-ink">{w.care}</dt>
                      <dd class="text-ink-soft">{wood.care[lang]}</dd>
                    </div>
                  </dl>
                </details>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 나무를 고르기 전에 -->
  <section class="sec-night grain relative overflow-hidden px-5 py-20 md:py-28 lg:px-8" aria-labelledby="tips-title">
    <div class="relative z-[2] mx-auto max-w-[76rem]">
      <h2 id="tips-title" class="display text-[clamp(2.2rem,4.6vw,3.6rem)] text-paper" data-split>{w.tipsTitle}</h2>
      <ul class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2" data-reveal>
        {
          w.tips.map((tip, i) => (
            <li class="rise border-t border-[var(--line)] pt-6" style={`--d:${i * 0.1}s`}>
              <h3 class="display text-[1.4rem] text-gold-2">{tip.title}</h3>
              <p class="mt-3 text-ivory-2">{tip.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 만들 물건으로 고르기 -->
  <section class="sec-wood px-5 py-20 md:py-28 lg:px-8" aria-labelledby="picks-title">
    <div class="mx-auto max-w-[76rem]">
      <h2 id="picks-title" class="display text-[clamp(2.2rem,4.6vw,3.6rem)] text-ink" data-split>{w.picksTitle}</h2>
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          PICKS.map((pick, i) => (
            <li class="rise relative border-t border-gold pt-5" style={`--d:${(i % 3) * 0.1}s`}>
              <h3 class="display text-[1.35rem] text-ink">{pick.title[lang]}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {pick.woods.map((key) => {
                  const wood = byKey.get(key)!;
                  return (
                    <li>
                      <a
                        href={`#${key}`}
                        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-gold/40 bg-black/30 px-3.5 text-[0.95rem] text-ivory hover:border-gold-2 hover:text-gold-2"
                      >
                        <i class="h-3 w-3 rounded-full" style={`background:linear-gradient(135deg,${wood.colors[0]},${wood.colors[1]})`} aria-hidden="true" />
                        {wood.name[lang]}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="mt-12 max-w-3xl text-ivory-2">{w.note}</p>
    </div>
  </section>

  <!-- 나무를 못 정하셨나요? -->
  <section class="sec-night grain relative overflow-hidden px-5 py-20 md:py-24 lg:px-8">
    <div class="relative z-[2] mx-auto flex max-w-[76rem] flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="display text-[clamp(2rem,4.4vw,3.4rem)] text-paper" data-split>{w.ctaTitle}</h2>
        <p class="mt-3 max-w-xl text-ivory-2">{w.ctaText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={`${localize(lang, '/contact')}#order`} class="btn-verm">
          <Icon name="tabler:clipboard-text" class="h-5 w-5" aria-hidden="true" />{t.cta.form}
        </a>
        <a href={shop.consult.href} class="btn-ghost">
          <Icon name="tabler:phone" class="h-5 w-5" aria-hidden="true" />{w.ctaCall}
        </a>
      </div>
    </div>
  </section>
</Layout>
