---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { FOREIGN_LOCALES, LANG_META, localize, useT } from '~/i18n';

const n = useT('ko').notFound;
---

<Layout metadata={{ title: n.title, robots: { index: false, follow: true } }}>
  <section class="sec-night grain relative overflow-hidden">
    <div class="relative z-[2] mx-auto max-w-7xl px-5 py-20 md:py-28 lg:px-8">
      <p class="display text-[clamp(5rem,16vw,10rem)] leading-none text-wood" aria-hidden="true">404</p>
      <h1 class="display mt-6 text-[clamp(2rem,4vw,3rem)] text-paper">{n.title}</h1>
      <p class="mt-3 text-lg text-paper/85">{n.text}</p>
      <p class="mt-1 text-paper/70" lang="en">This page could not be found.</p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href={getHomePermalink()} class="btn-verm">{n.home}</a>
        {
          FOREIGN_LOCALES.map((l) => (
            <a href={localize(l, '/')} lang={LANG_META[l].html} class="btn-ghost">
              {LANG_META[l].label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="rail-strip" aria-hidden="true"></div>
  </section>
</Layout>
