---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import LangSuggest from '~/components/common/LangSuggest.astro';
import Effects from '~/components/common/Effects.astro';
import PageShutter from '~/components/common/PageShutter.astro';
import SoundSystem from '~/components/common/SoundSystem.astro';
import { getAsset, getCanonical } from '~/utils/permalinks';
import { LANG_META, LOCALES, TRANSLATED_PAGES, langFromPath, localize, stripLang, useT, type Lang } from '~/i18n';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  lang?: Lang;
  /** 홈처럼 첫 화면이 영상이면 상단 메뉴를 투명하게 겹쳐 띄움 */
  headerOver?: boolean;
}

const { metadata: pageMeta = {}, lang = langFromPath(Astro.url.pathname), headerOver = false } = Astro.props;
const { textDirection } = I18N;
const t = useT(lang);
// 외국어 페이지는 제목 뒤에 그 나라 말 가게 이름을 붙임 (예: 作品 — チョウォル工芸)
const metadata =
  lang !== 'ko' && pageMeta.title && !pageMeta.ignoreTitleTemplate
    ? { ...pageMeta, title: `${pageMeta.title} — ${t.brand}`, ignoreTitleTemplate: true }
    : pageMeta;

// 같은 페이지의 다른 언어 주소 (검색엔진에 알려 줌)
const page = stripLang(Astro.url.pathname);
const alternates = TRANSLATED_PAGES.includes(page)
  ? [
      ...LOCALES.map((l) => ({ hreflang: LANG_META[l].html, href: String(getCanonical(localize(l, page))) })),
      { hreflang: 'x-default', href: String(getCanonical(localize('ko', page))) },
    ]
  : [];

// 카톡·SNS에 주소를 공유할 때 보이는 미리보기 이미지 (언어별, scripts/make_og.py로 만듦)
const OG_IMAGES: Record<Lang, { url: string; width: number; height: number }[]> = {
  ko: [{ url: '~/assets/images/og/og-ko.jpg', width: 1200, height: 630 }],
  en: [{ url: '~/assets/images/og/og-en.jpg', width: 1200, height: 630 }],
  ja: [{ url: '~/assets/images/og/og-ja.jpg', width: 1200, height: 630 }],
  zh: [{ url: '~/assets/images/og/og-zh.jpg', width: 1200, height: 630 }],
};

// 글꼴: 제목 나눔명조(굵게)만 내려받고, 본문은 기기에 있는 고딕(휴대폰에서 2MB 넘게 아낌 — CustomStyles.astro).
// 상호는 그림(public/brand/)이라 글꼴이 필요 없음. 일본어·중국어 페이지는 그 나라 명조를 더 불러옵니다.
// 한국어·영어 페이지는 작업 영상 자막용 고운바탕(굵게)도 — 자막이 있는 페이지에서만 실제로 받아짐(글자가 쓰일 때 받음)
const extraFonts: Partial<Record<Lang, string>> = {
  ko: '&family=Gowun+Batang:wght@700',
  en: '&family=Gowun+Batang:wght@700',
  ja: '&family=Shippori+Mincho+B1:wght@800',
  zh: '&family=Noto+Serif+SC:wght@700;900',
};
const fontHref = `https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@800${extraFonts[lang] ?? ''}&display=swap`;

---

<!doctype html>
<html
  lang={LANG_META[lang].html}
  dir={textDirection}
  class:list={['2xl:text-[19px]', { 'header-over': headerOver }]}
  data-lang={lang}
  style={`--tex-walnut:url('${getAsset('/tex/walnut.webp')}')`}
>
  <head>
    <CommonMeta />
    <meta name="theme-color" content="#120d09" />
    <Favicons />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      lang === 'zh' ? (
        <>
          {/* 중국 본토에서는 구글 글꼴이 막혀 있어, 기다리느라 페이지가 하얗게 멈추지 않게 따로(비동기로) 받음 */}
          <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
          <noscript>
            <link rel="stylesheet" href={fontHref} />
          </noscript>
        </>
      ) : (
        <link rel="stylesheet" href={fontHref} />
      )
    }
    <CustomStyles />
    <ApplyColorMode />
    <Metadata
      {...metadata}
      openGraph={{ locale: LANG_META[lang].og, images: OG_IMAGES[lang], ...metadata.openGraph }}
    />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <SiteVerification />
    <Analytics />
    <!-- 스크립트가 꺼진 브라우저: 화면에 들어올 때 드러나는 글·사진을 처음부터 보이게 -->
    <noscript>
      <style>
        [data-reveal] .rise,
        [data-reveal] .wipe {
          opacity: 1 !important;
          clip-path: none !important;
          transform: none !important;
        }
        .call-bar {
          visibility: visible !important;
          transform: none !important;
        }
        #intro {
          display: none !important;
        }
      </style>
    </noscript>

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page min-h-screen flex flex-col">
    <a href="#main" class="skip-link">{t.nav.skip}</a>
    <!-- 낙관(도장) 가장자리를 거칠게 만드는 필터 -->
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
      <filter id="seal-rough" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"></feDisplacementMap>
      </filter>
    </svg>
    <slot />

    <LangSuggest lang={lang} />
    <Effects />
    <PageShutter />
    <SoundSystem />
  </body>
</html>
